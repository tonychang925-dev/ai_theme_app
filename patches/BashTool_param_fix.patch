+/**
+ * 智能命令执行函数 - 彻底解决参数传递问题
+ * 当检测到write_file.sh调用时，使用更可靠的执行方式
+ */
+function executeCommandSmart(command: string, timeout?: number): Promise<ExecResult> {
+  // 检测是否是write_file.sh调用
+  const isWriteFileCommand = command.trim().startsWith('./write_file.sh') ||
+                            command.trim().startsWith('write_file.sh') ||
+                            command.trim().includes('safe_write') ||
+                            command.trim().includes('claude_write');
+
+  if (!isWriteFileCommand) {
+    // 非写入命令，使用原有执行逻辑
+    return exec(command, { timeout });
+  }
+
+  console.log('检测到写入命令，使用智能执行模式...');
+
+  // 对于写入命令，使用更可靠的执行方式
+  return new Promise((resolve, reject) => {
+    try {
+      // 解析命令参数
+      const parts = command.trim().split(/\s+/);
+      const scriptName = parts[0];
+
+      if (scriptName.includes('write_file.sh') || scriptName.includes('safe_write') || scriptName.includes('claude_write')) {
+        // 提取文件路径和内容
+        let filePath = '';
+        let content = '';
+
+        if (parts.length >= 3) {
+          // 简单情况：参数已经分开
+          filePath = parts[1].replace(/^["']|["']$/g, '');
+          content = parts.slice(2).join(' ').replace(/^["']|["']$/g, '');
+        } else if (parts.length === 2 && parts[1].includes('"')) {
+          // 复杂情况：参数包含在引号中
+          const match = command.match(/["']([^"']+)["']\s+["']([^"']+)["']/);
+          if (match) {
+            filePath = match[1];
+            content = match[2];
+          }
+        }
+
+        if (filePath && content !== '') {
+          // 使用安全的写入方式
+          const safeWriteScript = `
+            file_path="${filePath}"
+            content='${content.replace(/'/g, "'\"'\"'")}'
+            printf "%b" "$content" > "$file_path"
+            echo "✅ 文件写入成功: $file_path"
+          `;
+
+          execSync(safeWriteScript, { stdio: 'inherit', shell: '/bin/bash' });
+          resolve({ stdout: '文件写入成功', stderr: '', code: 0, interrupted: false });
+          return;
+        }
+      }
+    } catch (error) {
+      reject(error);
+    }
+  });
+}
