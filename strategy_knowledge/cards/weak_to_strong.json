  "source_refs": [
    {
      "document_id": "weak_to_strong_v1",
      "document_sha256": "84f33649b1071f337e6c2f02fd2c4421fe59b772c153b0a2e12201226d6035b0",
      "chunk_id": "weak_to_strong_v1.c01",
      "page": 1,
      "section": "什么是弱转强",
      "provenance_kind": "source_authored",
      "text": "龙头股在高位分歧后，出现看似走弱，但第二天通过强势反包、放量涨停，重新夺回市场话语权，完成从弱势到强势的转化。"
    },
    {
      "document_id": "weak_to_strong_v1",
      "document_sha256": "84f33649b1071f337e6c2f02fd2c4421fe59b772c153b0a2e12201226d6035b0",
      "chunk_id": "weak_to_strong_v1.c03",
      "page": 1,
      "section": "弱转强的特征信号",
      "provenance_kind": "source_authored",
      "text": "1. 前一日分歧…但收盘时仍有资金护盘，价格保持在关键支撑位（如5日/10日均线、前一日涨停价附近）。2. 次日反包…换手充分，封单果断…3. 板块联动：所属题材板块情绪没有全面退潮，仍有资金支撑。"
    },
    {
      "document_id": "weak_to_strong_v1",
      "document_sha256": "84f33649b1071f337e6c2f02fd2c4421fe59b772c153b0a2e12201226d6035b0",
      "chunk_id": "weak_to_strong_v1.c04",
      "page": 2,
      "section": "“弱”的典型——烂板（含五要素）",
      "provenance_kind": "source_authored",
      "text": "5、烂板5个要素：涨停位置：箱体突破位置，涨停板出现在前期高点位置；放量：把前期的套牢盘释放出来；炸板：不破板就没有机会进入；破板之后不能大跌，均线之上震荡，回撤幅度在3%之内…烂板时封单的量要比正常的封单的量少…烂板的封单下跌过程中呈现缩量走势，则代表抛压减少，“烂而不弱”则后续大概率能有更强的走势。"
    },
    {
      "document_id": "weak_to_strong_v1",
      "document_sha256": "84f33649b1071f337e6c2f02fd2c4421fe59b772c153b0a2e12201226d6035b0",
      "chunk_id": "weak_to_strong_v1.c11",
      "page": 4,
      "section": "注意事项",
      "provenance_kind": "source_authored",
      "text": "一定要是强势股或者龙头，杂毛不配弱转强！真：放量换手，封单坚决，次日承接良好。假：缩量拉升，封单虚弱，次日冲高回落。市场环境匹配：大盘极度退潮时，弱转强成功率极低。适合在“分歧—修复”阶段，而不是“全面退潮”时。"
    }
  ]
}
