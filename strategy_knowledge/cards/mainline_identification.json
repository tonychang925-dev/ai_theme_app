  "market_phases": ["all"],

  "trigger_conditions": [
    "一个新题材出现，需要判断是否值得参与",
    "题材异动排名靠前，需要判断它是主线还是小热点",
    "Julia 准备对某题材相关个股给出观察结论之前",
    "主线身份低频确认（确认后做周期跟踪，不做日重判）"
  ],

  "required_data": [
    "theme_catalyst_events",
    "theme_logic_attributes",
    "theme_capital_acceptance",
    "theme_mainline_environment"
  ],

  "possible_states": [
    {
      "state": "mainline_confirmed",
      "evidence_pattern": {
        "logic": "新颖度高 + 出现于低潮混沌期 + 影响面广",
        "market": "持续被更多资金买入认可",
        "environment": "非盛极而衰的大盘环境"
      },
      "predicates": [
        {"requirement_id": "theme_capital_acceptance", "operator": "eq", "value": "accepted", "role": "decisive"},
        {"requirement_id": "theme_mainline_environment", "operator": "in", "value": ["healthy", "neutral"], "role": "core"},
        {"requirement_id": "theme_logic_attributes", "path": "novelty", "operator": "in", "value": ["high", "medium"], "role": "core"},
        {"requirement_id": "theme_logic_attributes", "path": "timing", "operator": "eq", "value": "low_tide_chaos", "role": "core"},
        {"requirement_id": "theme_logic_attributes", "path": "breadth", "operator": "in", "value": ["broad", "medium"], "role": "supporting"}
      ],
      "action": "participate_only_this_mainline",
      "confidence_modifier": 0.25,
      "note": "只参与主线题材相关个股；大热点大干，不热衷小热点"
    },
    {
      "state": "logic_only_market_rejects",
      "evidence_pattern": {
        "logic": "逻辑符合三特征",
        "market": "资金不认可 / 无持续性"
      },
      "predicates": [
        {"requirement_id": "theme_capital_acceptance", "operator": "eq", "value": "rejected", "role": "decisive"}
      ],
      "action": "abandon",
      "confidence_modifier": -0.3,
      "note": "逻辑符合但市场不相信 → 果断放弃，不参与"
    },
    {
      "state": "not_mainline",
      "evidence_pattern": {
        "logic": "新颖度/时机/影响广度至少一项不满足",
        "market": "—"
      },
      "predicates": [
        {"requirement_id": "theme_logic_attributes", "path": "novelty", "operator": "eq", "value": "low", "role": "decisive"}
      ],
      "action": "no_participation",
      "confidence_modifier": -0.2,
      "note": "不满足两个维度条件的题材都不能算主线，尽量不参与操作"
    },
    {
      "state": "under_evaluation",
      "evidence_pattern": {
        "logic": "新题材，逻辑待定性",
        "market": "资金态度未明"
      },
      "predicates": [
        {"requirement_id": "theme_capital_acceptance", "operator": "eq", "value": "mixed", "role": "core"}
      ],
      "action": "observe_and_probe",
      "confidence_modifier": 0.0,
      "note": "新题材才触发身份增量评估；历史题材默认不重评"
    }
  ],

  "research_questions": [
    {
      "question": "该题材的逻辑是否满足新颖度、时机、影响广度三大特征？",
      "probes": ["theme_logic_attributes", "theme_catalyst_events"]
    },
    {
      "question": "市场资金是否持续买入并认可该题材？",
      "probes": ["theme_capital_acceptance"]
    },
    {
      "question": "题材来源属于政策 / 技术创新 / 重大事件 / 行业周期 / 资产重组中的哪一类？",
      "probes": ["theme_catalyst_events"]
    },
    {
      "question": "当前大盘环境是否允许做龙头（是否盛极而衰）？",
      "probes": ["theme_mainline_environment"]
    }
  ],

  "invalidations": [
    {"state": "mainline_confirmed", "condition": "capital_acceptance_degrades_to_rejected", "new_state": "logic_only_market_rejects"},
    {"state": "under_evaluation", "condition": "capital_acceptance_rejected", "new_state": "not_mainline"},
    {"state": "under_evaluation", "condition": "logic_attributes_fail_novelty", "new_state": "not_mainline"}
  ],

  "provenance": {
    "thresholds": "strategy_authored_qualitative",
