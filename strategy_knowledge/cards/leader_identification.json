{
  "strategy_id": "leader_identification",
  "name": "龙头识别",
  "concept": "龙头",
  "version": "2.0",
  "created_at": "2026-09-11",
  "derived_from_l1": true,

  "market_phases": ["start", "diffusion", "acceleration", "divergence"],

  "trigger_conditions": [
    "完成主线判定与切入周期评估之后",
    "需要在题材内选出龙头股与次龙头股",
    "候选个股需要判定在板块中的地位（领涨/跟风）",
    "出现二板晋级，需要判断是否形成龙头雏形"
  ],

  "required_data": [
    "board_position",
    "leader_seal_profile",
    "theme_breadth_depth",
    "second_board_status",
    "peer_relative_strength"
  ],

  "possible_states": [
    {
      "state": "leader_confirmed",
      "evidence_pattern": {
        "position": "板块地位第一",
        "identification": "最快封板 / 封单金额最大 / 资金最狠",
        "attributes": "首板换手率>8% / 量比>2.5 / 持续放量",
        "breadth": "题材具备深广度",
        "resilience": "大盘或板块走弱时依然强势涨停"
      },
      "predicates": [
        {"requirement_id": "board_position", "operator": "eq", "value": "leader", "role": "decisive"},
        {"requirement_id": "theme_breadth_depth", "operator": "in", "value": ["deep_wide", "moderate"], "role": "core"},
        {"requirement_id": "leader_seal_profile", "path": "first_board_turnover", "operator": ">=", "value": 0.08, "role": "supporting"},
        {"requirement_id": "leader_seal_profile", "path": "volume_ratio", "operator": ">=", "value": 2.5, "role": "supporting"}
      ],
      "action": "trade_leader",
      "confidence_modifier": 0.3,
      "note": "宁愿在涨停板上追龙头，也不要在低位买跟风股；不要在龙头股上做短线"
    },
    {
      "state": "sub_leader",
      "evidence_pattern": {
        "position": "板块地位第二/第三",
        "role": "次龙头 / 龙二",
        "breadth": "随龙头走强但有溢价"
      },
      "predicates": [
        {"requirement_id": "board_position", "operator": "eq", "value": "sub_leader", "role": "core"},
        {"requirement_id": "peer_relative_strength", "path": "dispersion.max_min_spread", "operator": ">=", "value": 0.10, "role": "supporting"}
      ],
      "action": "trade_with_light_position",
      "confidence_modifier": 0.1,
      "note": "买不到龙头就买龙二；但仓位要轻（防假突破）"
    },
    {
      "state": "arbitrage_20cm",
      "evidence_pattern": {
        "anchor": "龙头隔夜大单 / 一字板定方向",
        "trigger": "主板涨停越多越好，找 20cm 半路票"
      },
      "predicates": [
        {"requirement_id": "board_position", "operator": "eq", "value": "leader", "role": "supporting"},
        {"requirement_id": "board_position", "path": "board", "operator": "eq", "value": "gem_20cm", "role": "core"}
      ],
      "action": "arbitrage_only",
      "confidence_modifier": 0.05,
      "note": "创业板 20cm 套利，锚定龙头隔夜大单与一字板方向"
    },
    {
      "state": "follower_excluded",
      "evidence_pattern": {
        "position": "板块后排 / 跟风 / 杂毛",
        "identification": "非领涨、无辨识度"
      },
      "predicates": [
        {"requirement_id": "board_position", "operator": "in", "value": ["follower", "outsider"], "role": "decisive"}
      ],
      "action": "exclude",
      "confidence_modifier": -0.4,
      "note": "绝不介入后排杂毛个股；跟风股分歧不能买，补涨股特别小心"
    },
    {
      "state": "leader_rotation",
      "evidence_pattern": {
        "position": "原龙头走弱但新核心出现",
        "identification": "新票封板更快更强",
        "breadth": "题材整体未退潮"
      },
      "predicates": [
        {"requirement_id": "board_position", "operator": "eq", "value": "leader", "role": "core"},
        {"requirement_id": "theme_breadth_depth", "operator": "!=", "value": "narrow", "role": "supporting"}
      ],
      "action": "monitor_new_leader",
      "confidence_modifier": 0.0,
      "note": "老龙头走弱但新核心出现 — 不是退潮，是切换"
    }
  ],

  "research_questions": [
    {
      "question": "该股在板块中的地位是否为第一位（是否领涨）？",
      "probes": ["board_position", "peer_relative_strength"]
    },
    {
      "question": "封板时间、封单金额、首板换手率、量比是否具备龙头特征？",
      "probes": ["leader_seal_profile"]
    },
    {
      "question": "题材的深广度是否足以支撑龙头走出高度？",
      "probes": ["theme_breadth_depth"]
    },
    {
      "question": "是否已出现二板定龙头雏形（换手板 + 分歧转一致 + 板块合力）？",
      "probes": ["second_board_status", "board_position"]
    }
  ],

  "invalidations": [
    {"state": "leader_confirmed", "condition": "position_degrades_and_breadth_contracts", "new_state": "leader_rotation"},
    {"state": "leader_confirmed", "condition": "leader_loses_sector_first_position", "new_state": "sub_leader"},
    {"state": "sub_leader", "condition": "new_first_position_emerges", "new_state": "monitor_new_leader"}
  ],

