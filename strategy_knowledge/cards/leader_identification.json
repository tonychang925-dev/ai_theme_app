  "source_refs": [
    {
      "document_id": "trading_system_v1",
      "document_sha256": "05d7108a557d91a9e45a7653af92cc2cf72236796962e6965420b29a40dc8676",
      "chunk_id": "trading_system_v1.c10",
      "page": 3,
      "section": "盯龙头核心(20%) — 核心个股 / 龙头个股特征",
      "provenance_kind": "source_authored",
      "text": "只考虑龙头和次龙头、套利、补涨个股，绝不介入后排杂毛个股…宁愿在涨停板上追龙头，也不要在低位买跟风股！龙头股的特征：硬逻辑…高辨识度：分析是否具备领涨特征（封板金额、封板时间及形态），最快封板，资金最狠最夸张…属性：（人气最旺、资金性质以游资为主、涨幅最高、首板换手率>8%、量比>2.5、持续放量…）抗下跌：大环境如大盘和板块走弱的情况，依然强势涨停。"
    },
    {
      "document_id": "trading_system_v1",
      "document_sha256": "05d7108a557d91a9e45a7653af92cc2cf72236796962e6965420b29a40dc8676",
      "chunk_id": "trading_system_v1.c11",
      "page": 4,
      "section": "龙头操作要领五条",
      "provenance_kind": "source_authored",
      "text": "1、要能准确判断龙头股，选股过程中，股票的所处板块的地位是第一位的…2、克服恐惧感，第一时间亮剑买入…3、要捂得住，不要失去位置；4、不要在龙头股上做短线！5、如果买不到龙头，就买龙二。"
    },
    {
      "document_id": "trading_system_v1",
      "document_sha256": "05d7108a557d91a9e45a7653af92cc2cf72236796962e6965420b29a40dc8676",
      "chunk_id": "trading_system_v1.c12",
      "page": 4,
      "section": "套利个股（创业板20cm）/ 补涨股",
      "provenance_kind": "source_authored",
      "text": "2）套利个股：创业板20cm核心个股。锚定龙头隔夜大单，一字板…此时可以找20cm的半路票，俗称“一字板定方向”！"
    },
    {
      "document_id": "limit_up_v1",
      "document_sha256": "2186f1bb0735fc4214f615ec80b0089e683f728a1e3312f055525b5af038918c",
      "chunk_id": "limit_up_v1.c04",
      "page": 2,
      "section": "二板定龙头 — 量价特征 / 题材逻辑 / 盘口气质 / 情绪位置",
      "provenance_kind": "source_authored",
      "text": "真正有龙头潜质的个股，首板最好是换手板（换手率 >15%，成交额活跃）…二板放量但分歧转一致（下杀后快速拉起），说明承接力强…封单质量：龙头的封单往往稳定，资金不断加仓，不轻易被撬开…龙头往往诞生在情绪冰点后第一波反弹…如果一个题材里出现多个首板，次日看谁率先走出二板，这就是龙头雏形。"
    }
  ]
}
