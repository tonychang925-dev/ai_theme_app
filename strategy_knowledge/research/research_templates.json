{
  "schema_version": "strategy-research-templates.v1",
  "layer": "L4",
  "kind": "research_templates",
  "authority": "advisory_only",
  "boundary_flags": {
    "not_prompt_material": true,
    "does_not_answer_questions": true,
    "does_not_override_market_facts": true,
    "note": "ADR-032：研究模板只规定「该问什么问题」，不给出结论。模板本身不产生答案，答案必须来自证据。"
  },
  "purpose": "为每一种冲突模式规定：竞争假设是什么、按什么顺序提哪些问题、每个问题能区分开哪些假设、证据到什么程度才算够、证据不足时如何显式降级。",
  "insufficiency_policy": {
    "default": "INSUFFICIENT_EVIDENCE",
    "rule": "若关键 probes 缺失或未达 sufficient_evidence_rule，不得输出结论，必须显式返回 INSUFFICIENT_EVIDENCE 并列出缺口。",
    "forbidden": [
      "用默认值/占位值填充缺失证据后给结论",
      "把 UNAVAILABLE 当作 EMPTY",
      "让策略规则覆盖市场事实"
    ]
  },
  "templates": [
    {
      "template_id": "RT-01",
      "conflict_pattern": "龙头走弱：正常调整 / 主动分歧 / 结构破坏 / 新老切换，四者证据重叠难以区分",
      "conflict_type": "state_competition",
      "applies_to_cards": ["leader_divergence"],
      "competing_hypotheses": ["normal_adjustment", "active_divergence", "leader_failure", "leader_rotation"],
      "questions": [
        {
          "question": "龙头从峰值的回撤幅度有多大？",
          "probes": ["leader_drawdown_from_peak"],
          "discriminates": ["normal_adjustment(<=5%)", "active_divergence(5-15%)", "leader_failure(>15%)"],
          "priority": "primary"
        },
        {
          "question": "关键支撑位是完好、正在测试，还是已被击穿？",
          "probes": ["key_level_status"],
          "discriminates": ["normal_adjustment(intact)", "active_divergence(testing)", "leader_failure(broken)"],
          "priority": "primary"
        },
        {
          "question": "下跌时量能是缩量（卖压不足）还是放量（真出货）？",
          "probes": ["leader_volume_pattern"],
          "discriminates": ["normal_adjustment(contracting)", "leader_failure(heavy_selling)"],
          "priority": "primary"
        },
        {
          "question": "题材整体宽度是在扩张还是收缩？",
          "probes": ["theme_breadth_change", "breadth_trend"],
          "discriminates": ["normal_adjustment(expanding)", "leader_failure(contracting)"],
          "priority": "secondary"
        },
        {
          "question": "是否出现了新的核心标的（同题材但封板更快更强）？",
          "probes": ["new_leader_candidates", "peer_relative_strength"],
          "discriminates": ["leader_rotation", "leader_failure"],
          "priority": "primary"
        },
        {
          "question": "大盘环境是否处于盛极而衰？",
          "probes": ["market_regime", "theme_mainline_environment"],
          "discriminates": ["触发 HR-007 硬约束的情形"],
          "priority": "secondary"
        }
      ],
      "sufficient_evidence_rule": "leader_drawdown_from_peak + key_level_status + leader_volume_pattern 三项齐备，方可排除 INSUFFICIENT_EVIDENCE。",
      "default_when_insufficient": "INSUFFICIENT_EVIDENCE：只报「龙头走弱，状态待定」，不猜具体状态。",
      "resolution_map": [
        {"if": "市场环境为盛极而衰(HR-007)", "then": "不参与，状态判定让位于硬约束"},
        {"if": "new_leader_candidates>=1 且宽度未收缩", "then": "leader_rotation（切换而非退潮）"},
        {"if": "key_level=broken 且 volume=heavy_selling 且 宽度收缩", "then": "leader_failure"},
        {"if": "回撤5-15% 且 key_level=testing", "then": "active_divergence → 转 weak_to_strong 看次日"}
      ],
      "source_refs": [{"chunk_id": "trading_system_v1.c07"}, {"chunk_id": "trading_system_v1.c10"}],
      "figure_refs": [{"figure_id": "trading_system_v1.fig-002"}]
    },
    {
      "template_id": "RT-02",
      "conflict_pattern": "弱转强真假之辨：真弱转强 / 假弱转强 / 烂板待观察 / 尚无信号",
      "conflict_type": "state_competition",
      "applies_to_cards": ["weak_to_strong"],
      "competing_hypotheses": ["confirmed_weak_to_strong", "false_weak_to_strong", "bad_limit_up_candidate", "no_signal_yet"],
      "questions": [
        {
          "question": "候选票是否为强势股或龙头？（这是准入前提）",
          "probes": ["board_position"],
          "discriminates": ["触发 HR-001 硬约束的情形"],
          "priority": "primary"
        },
        {
          "question": "次日是放量换手、封单坚决，还是缩量拉升、封单虚弱？",
          "probes": ["intraday_volume", "limit_up_seal_quality"],
          "discriminates": ["confirmed(放量+decdecisive)", "false(缩量+weak/no_seal)"],
          "priority": "primary"
        },
        {
          "question": "前一日分歧后收盘是否守住关键支撑（5日/10日线、前涨停价）？",
          "probes": ["leader_key_level"],
          "discriminates": ["confirmed(intact)", "false(broken)"],
          "priority": "primary"
        },
        {
          "question": "板块是否有联动确认（题材未全面退潮、有补涨助攻）？",
          "probes": ["peer_follow_through"],
          "discriminates": ["confirmed(>=0.5)", "false(<0.5)"],
          "priority": "secondary"
        },
        {
          "question": "前一日是否为烂板？烂板是否满足「烂而不弱」五要素？",
          "probes": ["limit_up_seal_quality", "intraday_volume", "leader_key_level"],
          "discriminates": ["bad_limit_up_candidate 的成立与否"],
          "priority": "secondary"
        },
        {
          "question": "大盘是否极度退潮？",
          "probes": ["market_regime", "theme_fade_status"],
          "discriminates": ["触发 HR-002 硬约束的情形"],
          "priority": "secondary"
        }
      ],
      "sufficient_evidence_rule": "intraday_volume + limit_up_seal_quality + leader_key_level 三项齐备。",
      "default_when_insufficient": "INSUFFICIENT_EVIDENCE：不判定真假弱转强，仅记录候选。",
      "resolution_map": [
        {"if": "非强势股/非龙头(HR-001)", "then": "直接剔除，不进入真假判定"},
        {"if": "大盘极度退潮(HR-002)", "then": "不做弱转强"},
        {"if": "放量换手 + 封单坚决 + 守住支撑 + 板块联动", "then": "confirmed_weak_to_strong → 交由 entry_timing / position_sizing"},
        {"if": "缩量拉升 + 封单虚弱 + 跌破支撑", "then": "false_weak_to_strong → avoid_or_exit"}
      ],
      "source_refs": [
        {"chunk_id": "weak_to_strong_v1.c03"},
        {"chunk_id": "weak_to_strong_v1.c04"},
        {"chunk_id": "weak_to_strong_v1.c11"}
      ],
      "figure_refs": [{"figure_id": "weak_to_strong_v1.fig-002"}, {"figure_id": "weak_to_strong_v1.fig-006"}]
    },
    {
      "template_id": "RT-03",
      "conflict_pattern": "题材处于周期哪个阶段：分歧关注 / 弱转强切入 / 再次高潮离场 / 分歧补涨 相邻阶段易混",
      "conflict_type": "state_competition",
      "applies_to_cards": ["theme_lifecycle"],
      "competing_hypotheses": ["分歧关注", "弱转强切入", "再次高潮离场", "分歧补涨", "退潮放弃"],
      "questions": [
        {
          "question": "龙头是否已出现首阴分歧？",
          "probes": ["leader_board_height", "leader_volume_pattern"],
          "discriminates": ["进入分歧关注的门槛"],
          "priority": "primary"
        },
        {
          "question": "首阴次日是否反包、放量涨停（弱转强确认）？",
          "probes": ["reverse_package_status"],
          "discriminates": ["弱转强切入", "分歧关注（未确认）"],
          "priority": "primary"
        },
        {
          "question": "连板高度是否大面积降级、打板数量是否逐日下降？",
          "probes": ["leader_board_height", "limit_up_count_trend"],
          "discriminates": ["再次高潮离场", "发酵进场/高潮警惕"],
          "priority": "primary"
        },
        {
          "question": "是否出现高标龙头再次分歧、同时后排补涨？",
          "probes": ["breadth_trend", "peer_relative_strength"],
          "discriminates": ["分歧补涨"],
          "priority": "secondary"
        },
        {
          "question": "板块是否大面积跌停、龙头连续下跌？",
          "probes": ["breadth_trend", "limit_up_count_trend"],
          "discriminates": ["退潮放弃"],
          "priority": "primary"
        },
        {
          "question": "题材已运行多少天、当前处于 0-4 哪一级行情？",
          "probes": ["theme_age_days"],
          "discriminates": ["阶段先后次序校验"],
          "priority": "secondary"
        }
      ],
      "sufficient_evidence_rule": "leader_board_height + limit_up_count_trend + reverse_package_status 三项齐备。",
      "default_when_insufficient": "INSUFFICIENT_EVIDENCE：不报阶段，只报可观测事实。",
      "resolution_map": [
        {"if": "首阴 + 未反包", "then": "分歧关注（当天不低吸）"},
        {"if": "次日反包放量涨停", "then": "弱转强切入"},
        {"if": "连板降级 + 打板数递减", "then": "再次高潮离场 → 止盈"},
        {"if": "高标再分歧 + 后排补涨", "then": "分歧补涨 → 不参与跟风二次分歧(HR-017)"}
      ],
      "source_refs": [
        {"chunk_id": "trading_system_v1.c03"},
        {"chunk_id": "trading_system_v1.c07"},
        {"chunk_id": "trading_system_v1.c09"}
      ],
      "figure_refs": [{"figure_id": "trading_system_v1.fig-001"}]
    },
    {
      "template_id": "RT-04",
      "conflict_pattern": "主线身份判定：逻辑成立但市场不认 / 不满足维度 / 评估中 / 已确认",
      "conflict_type": "state_competition",
      "applies_to_cards": ["mainline_identification"],
      "competing_hypotheses": ["mainline_confirmed", "logic_only_market_rejects", "not_mainline", "under_evaluation"],
      "questions": [
        {
          "question": "题材逻辑是否满足新颖度、时机（是否出现在低潮混沌期）、影响广度三特征？",
          "probes": ["theme_logic_attributes"],
          "discriminates": ["逻辑维度是否成立"],
          "priority": "primary"
        },
        {
          "question": "市场资金是否持续买入并认可（而非仅逻辑成立）？",
          "probes": ["theme_capital_acceptance"],
          "discriminates": ["mainline_confirmed", "logic_only_market_rejects"],
          "priority": "primary"
        },
        {
          "question": "该题材的催化剂事件属于政策/技术创新/重大事件/行业周期/资产重组中的哪一类？",
          "probes": ["theme_catalyst_events"],
          "discriminates": ["题材来源归类"],
          "priority": "secondary"
        },
        {
          "question": "大盘环境是否允许做龙头（是否盛极而衰）？",
          "probes": ["theme_mainline_environment"],
          "discriminates": ["触发 HR-007 的情形"],
          "priority": "secondary"
        }
      ],
      "sufficient_evidence_rule": "theme_logic_attributes + theme_capital_acceptance 两项齐备。",
      "default_when_insufficient": "INSUFFICIENT_EVIDENCE：按 under_evaluation 处理，只观察不下结论。",
      "resolution_map": [
        {"if": "逻辑三特征成立 且 资金持续认可 且 环境不敌对", "then": "mainline_confirmed"},
        {"if": "逻辑成立但资金不认可", "then": "logic_only_market_rejects → 果断放弃"},
        {"if": "不满足两维度之一(HR-009)", "then": "not_mainline → 不参与"}
      ],
      "source_refs": [{"chunk_id": "trading_system_v1.c01"}, {"chunk_id": "trading_system_v1.c02"}],
      "figure_refs": [{"figure_id": "trading_system_v1.fig-009"}]
    },
    {
      "template_id": "RT-05",
      "conflict_pattern": "个股在板块中的角色：龙头 / 次龙头 / 套利票 / 后排杂毛 / 新老切换",
      "conflict_type": "state_competition",
      "applies_to_cards": ["leader_identification"],
      "competing_hypotheses": ["leader_confirmed", "sub_leader", "arbitrage_20cm", "follower_excluded", "leader_rotation"],
      "questions": [
        {
          "question": "该股在板块中的地位是否为第一（是否领涨）？",
          "probes": ["board_position", "peer_relative_strength"],
          "discriminates": ["leader_confirmed", "sub_leader", "follower_excluded"],
          "priority": "primary"
        },
        {
          "question": "封板时间、封单金额、首板换手率(>8%)、量比(>2.5) 是否具备龙头特征？",
          "probes": ["leader_seal_profile"],
          "discriminates": ["leader_confirmed 的成立与否"],
          "priority": "primary"
        },
        {
          "question": "题材深广度是否足以支撑龙头走出高度？",
          "probes": ["theme_breadth_depth"],
          "discriminates": ["龙头高度预期"],
          "priority": "secondary"
        },
        {
          "question": "是否已是二板、且为换手板 + 分歧转一致？",
          "probes": ["second_board_status", "leader_seal_profile"],
          "discriminates": ["二板定龙头雏形"],
          "priority": "secondary"
        },
        {
          "question": "原龙头走弱但新核心出现时，宽度是否仍在？",
          "probes": ["board_position", "theme_breadth_depth"],
          "discriminates": ["leader_rotation"],
          "priority": "secondary"
        }
      ],
      "sufficient_evidence_rule": "board_position + leader_seal_profile 两项齐备。",
      "default_when_insufficient": "INSUFFICIENT_EVIDENCE：不判定角色。",
      "resolution_map": [
        {"if": "board_position in [follower, outsider]", "then": "follower_excluded（HR-010 绝不介入）"},
        {"if": "地位第一 + 龙头特征齐 + 深广度足", "then": "leader_confirmed"},
        {"if": "地位第二/第三", "then": "sub_leader → 仓位走轻档(SH-003/HR-005)"}
      ],
      "source_refs": [
        {"chunk_id": "trading_system_v1.c10"},
        {"chunk_id": "trading_system_v1.c11"},
        {"chunk_id": "limit_up_v1.c04"}
      ],
      "figure_refs": [{"figure_id": "trading_system_v1.fig-009"}]
    },
    {
      "template_id": "RT-06",
      "conflict_pattern": "买点判定：可买 / 缩量诱多须观望 / 不放量不买 / 空仓观望",
      "conflict_type": "state_competition",
      "applies_to_cards": ["entry_timing"],
      "competing_hypotheses": ["buy_platform_breakout", "buy_ma_reclaim", "buy_on_pullback", "reject_shrinking_rally", "reject_no_volume", "abstain"],
      "questions": [
        {
          "question": "即时交易线是否在分时均线上方？",
          "probes": ["intraday_ma_status"],
          "discriminates": ["可买区(above)", "禁止区(below, HR-011)"],
          "priority": "primary"
        },
        {
          "question": "当下是否放量？",
          "probes": ["intraday_volume_expansion"],
          "discriminates": ["可买(expanding)", "不放量不买(HR-012)"],
          "priority": "primary"
        },
        {
          "question": "是否突破半小时以上的分时盘整平台？",
          "probes": ["intraday_platform_break"],
          "discriminates": ["buy_platform_breakout"],
          "priority": "primary"
        },
        {
          "question": "是否出现 MACD 顶背离或红柱缩头死叉（诱多特征）？",
          "probes": ["macd_divergence_state"],
          "discriminates": ["reject_shrinking_rally（HR-022）"],
          "priority": "primary"
        },
        {
          "question": "回踩的关键支撑（5日/10日线、前低、前板封单价）是否有效？",
          "probes": ["key_level_status"],
          "discriminates": ["buy_on_pullback", "abstain(broken)"],
          "priority": "secondary"
        },
        {
          "question": "盘前涨跌停家数、板块涨幅、昨日热点延续性是否支持接力？",
          "probes": ["premarket_market_checks"],
          "discriminates": ["当日是否具备接力环境"],
          "priority": "secondary"
        }
      ],
      "sufficient_evidence_rule": "intraday_ma_status + intraday_volume_expansion 两项齐备（分钟级数据缺失时直接判 INSUFFICIENT_EVIDENCE）。",
      "default_when_insufficient": "INSUFFICIENT_EVIDENCE：不判定买点；分钟级数据不可用时不得用日线代替。",
      "resolution_map": [
        {"if": "白线在黄线下方", "then": "abstain（HR-011 坚决不买）"},
        {"if": "未放量", "then": "reject_no_volume（HR-012）"},
        {"if": "顶背离 + 量缩 + 白线远离黄线", "then": "reject_shrinking_rally（HR-022）"},
        {"if": "突破平台 + 放量", "then": "buy_platform_breakout → 移交 position_sizing"}
      ],
      "source_refs": [
        {"chunk_id": "trading_system_v1.c13"},
        {"chunk_id": "trading_system_v1.c14"},
        {"chunk_id": "trading_system_v1.c15"},
        {"chunk_id": "weak_to_strong_v1.c08"}
      ],
      "figure_refs": [
        {"figure_id": "trading_system_v1.fig-003"},
        {"figure_id": "trading_system_v1.fig-004"},
        {"figure_id": "trading_system_v1.fig-005"}
      ]
    },
    {
      "template_id": "RT-07",
      "conflict_pattern": "仓位档位选择：试仓 1-2成 / 龙头 5-8成 / 次龙头 2-4成 / 降仓",
      "conflict_type": "state_competition",
      "applies_to_cards": ["position_sizing"],
      "competing_hypotheses": ["position_probe_light", "position_main_leader_heavy", "position_sub_leader_light", "position_after_confirmation", "position_fade_watch_reduce"],
      "questions": [
        {"question": "该票是主线题材的绝对龙头，还是龙二/次龙头？", "probes": ["board_position", "theme_breadth_depth"], "discriminates": ["5-8成档", "2-4成档"], "priority": "primary"},
        {"question": "支撑力度是否达标（支撑评分）？", "probes": ["support_strength"], "discriminates": ["是否具备建仓资格"], "priority": "primary"},
        {"question": "竞价确认级别是 A / B / C / X？", "probes": ["auction_confirm_level"], "discriminates": ["是否可加仓至中等仓位"], "priority": "primary"},
        {"question": "题材是否进入退潮观察（fade_watch）或环境转弱？", "probes": ["theme_fade_watch", "market_regime"], "discriminates": ["降仓/不参与"], "priority": "primary"}
      ],
      "sufficient_evidence_rule": "board_position + support_strength 齐备；auction_confirm_level 缺失时不得给 A 级档。",
      "default_when_insufficient": "INSUFFICIENT_EVIDENCE：不给仓位数字，只给区间下限（试仓）。",
      "resolution_map": [
        {"if": "主线+绝对龙头+深广度足+fade_watch=false", "then": "5-8成（SH-003）"},
        {"if": "龙二/次龙头", "then": "2-4成"},
        {"if": "首次尝试", "then": "1-2成"},
        {"if": "始终", "then": "HR-005 禁止满仓"}
      ],
      "source_refs": [{"chunk_id": "weak_to_strong_v1.c09"}],
      "figure_refs": [{"figure_id": "weak_to_strong_v1.fig-006"}]
    },
    {
      "template_id": "RT-08",
      "conflict_pattern": "持仓处置：继续持有 / 减仓 / 清仓",
      "conflict_type": "state_competition",
      "applies_to_cards": ["exit_rules"],
      "competing_hypotheses": ["hold_for_second_wave", "hold_no_action", "reduce_on_reverse_fail", "reduce_on_intraday_ma_break", "exit_on_support_break", "exit_theme_fade"],
      "questions": [
        {"question": "反包是成功、失败还是待定？", "probes": ["reverse_package_status", "key_level_status"], "discriminates": ["hold", "reduce"], "priority": "primary"},
