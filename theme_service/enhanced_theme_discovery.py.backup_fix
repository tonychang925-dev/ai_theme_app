#!/usr/bin/env python3
"""
主题发现业务引擎 - 重构版（使用AI相似性分析）
🔥 核心职责：执行业务逻辑，使用AI相似性分析器
🚀 增强版：包含重复主题处理、详细进度显示和健壮错误处理
"""
import os
import sys

# 🔥 修复Python路径 - 确保能导入所有模块
current_dir = os.path.dirname(os.path.abspath(__file__))
project_root = os.path.dirname(current_dir)  # 项目根目录
sys.path.insert(0, project_root)

import asyncio
import logging
import re
from typing import Dict, Any, List, Optional
from datetime import datetime
from collections import defaultdict

logger = logging.getLogger(__name__)

class EnhancedThemeDiscoveryEngine:
    """
    主题发现业务引擎 - 重构版
    使用AI相似性分析器，彻底取代关键词匹配
    增强功能：重复主题处理、进度跟踪、详细日志
    """
    
    def __init__(self, 
                 ai_client,           # EnhancedAIThemeClient实例
                 database_client,     # DatabaseClient实例
                 similarity_analyzer, # AIThemeSimilarityAnalyzer实例（新增）
                 config: Optional[Dict] = None):
        """
        初始化业务引擎
        
        Args:
            ai_client: EnhancedAIThemeClient实例
            database_client: DatabaseClient实例
            similarity_analyzer: AIThemeSimilarityAnalyzer实例（关键新增）
            config: 配置参数
        """
        self.ai_client = ai_client
        self.db_client = database_client
        self.similarity_analyzer = similarity_analyzer
        
        # 🔥 创建新的RelatedThemeFetcher（使用AI相似性分析）
        from database_service.pure_data_fetcher import PureDataFetcher
        from theme_service.related_theme_fetcher import RelatedThemeFetcher
        
        # 关键修复：传递正确的DatabaseManager实例
        # 从database_client获取底层的db_manager
        if hasattr(database_client, '_db'):
            db_manager = database_client._db
        elif hasattr(database_client, 'db_manager'):
            db_manager = database_client.db_manager
        else:
            # 如果database_client本身就是DatabaseManager，直接使用
            db_manager = database_client
        
        # 创建纯数据获取器，传递DatabaseManager
        data_fetcher = PureDataFetcher(db_manager)
        
        # 创建使用AI相似性分析的检索器
        self.theme_fetcher = RelatedThemeFetcher(
            data_fetcher=data_fetcher,
            similarity_analyzer=similarity_analyzer,
            use_cache=True
        )
        
        # 配置参数
        self.config = config or {}
        
        # 阈值配置
        self.fast_track_threshold = self.config.get('fast_track_threshold', 0.90)
        self.review_threshold = self.config.get('review_threshold', 0.65)
        self.ignore_threshold = self.config.get('ignore_threshold', 0.3)
        
        # 状态追踪
        self.processing_stats = defaultdict(int)
        self._reset_stats()
        
        # 进度跟踪
        self.start_time = datetime.now()
        
        logger.info(f"🚀 EnhancedThemeDiscoveryEngine 初始化完成（AI相似性分析版）")
        logger.info(f"  组件: AI客户端 ✅, 数据库客户端 ✅, AI相似性分析器 ✅")
        logger.info(f"  主题检索器: 使用AI相似性分析（非关键词匹配）")
        logger.info(f"  增强功能: 重复主题处理、详细进度跟踪")
    
    def _reset_stats(self):
        """重置统计信息"""
        self.processing_stats.update({
            'total_processed': 0,
            'created': 0,
            'merged': 0,
            'ignored': 0,
            'failed': 0,
            'duplicate_resolved': 0,  # 新增：重复主题解决次数
            'ai_similarity_calls': 0,
            'processing_time_total': 0.0
        })
    
    async def _safe_create_theme(self, theme_data: Dict[str, Any]) -> Optional[Dict[str, Any]]:
        """
        安全创建主题，自动处理重复主题情况
        
        Args:
            theme_data: 主题数据
            
        Returns:
            主题信息或None（如果创建失败）
        """
        theme_name = theme_data.get('name', '')
        
        try:
            # 首先检查主题是否已存在
            existing_theme = await self.db_client.get_theme_by_name(theme_name)
            if existing_theme:
                logger.warning(f"⚠️ 主题 '{theme_name}' 已存在，使用现有主题 (ID: {existing_theme.get('id')})")
                self.processing_stats['duplicate_resolved'] += 1
                return existing_theme
            
            # 主题不存在，正常创建
            theme = await self.db_client.create_theme(**theme_data)
            logger.info(f"✅ 创建新主题: {theme['name']} (ID: {theme['id']})")
            return theme
            
        except Exception as e:
            error_msg = str(e)
            
            # 处理重复主题错误
            if "已存在" in error_msg or "duplicate" in error_msg.lower() or "DuplicateError" in error_msg:
                logger.warning(f"🔄 捕获到重复主题错误: '{theme_name}'，尝试获取现有主题")
                
                # 再次尝试获取现有主题
                try:
                    existing_theme = await self.db_client.get_theme_by_name(theme_name)
                    if existing_theme:
                        self.processing_stats['duplicate_resolved'] += 1
                        logger.info(f"✅ 成功获取现有主题: {theme_name} (ID: {existing_theme.get('id')})")
                        return existing_theme
                    else:
                        logger.error(f"❌ 主题 '{theme_name}' 报重复错误但无法获取")
                except Exception as get_error:
                    logger.error(f"❌ 获取现有主题失败: {get_error}")
            
            # 重新抛出其他错误
            logger.error(f"❌ 创建主题失败: {error_msg}")
            raise
    
    async def process_single_event(self, event: Dict[str, Any], show_progress: bool = True) -> Dict[str, Any]:
        """
        处理单个事件（使用AI相似性分析）
        
        Args:
            event: 事件数据，必须包含id和theme_directive
            show_progress: 是否显示进度信息
            
        Returns:
            处理结果
        """
        event_id = event.get('id') or event.get('news_id') or event.get('event_id', 'unknown')
        event['id'] = event_id  # 确保有id字段
        
        start_time = datetime.now()
        
        if show_progress:
            elapsed_total = (datetime.now() - self.start_time).total_seconds()
            logger.info(f"\n{'='*60}")
            logger.info(f"🚀 开始处理事件 {event_id} (总耗时: {elapsed_total:.1f}s)")
            logger.info(f"📰 标题: {event.get('title', '无标题')[:50]}...")
        
        self.processing_stats['total_processed'] += 1
        
        # 初始化结果结构
        result = {
            'event_id': event_id,
            'processed_at': datetime.now().isoformat(),
            'status': 'pending',
            'engine_version': 'ai_similarity_engine_v1',
            'processing_steps': []
        }
        
        try:
            # === 步骤1：验证事件数据 ===
            step_start = datetime.now()
            result['processing_steps'].append({
                'step': 'validate_event',
                'status': 'started',
                'timestamp': datetime.now().isoformat()
            })
            
            if 'theme_directive' not in event:
                logger.warning(f"事件 {event_id} 缺少theme_directive，添加默认指令")
                event['theme_directive'] = {
                    'action': 'CREATE_NEW',
                    'confidence': 0.75,
                    'reason': '默认指令'
                }
            
            result['processing_steps'][-1]['status'] = 'completed'
            result['processing_steps'][-1]['duration'] = (datetime.now() - step_start).total_seconds()
            
            if show_progress:
                logger.info(f"✅ 步骤1: 事件验证完成 ({result['processing_steps'][-1]['duration']:.2f}s)")
            
            # === 步骤2：使用AI相似性分析器获取相关主题 ===
            step_start = datetime.now()
            result['processing_steps'].append({
                'step': 'fetch_related_themes_ai',
                'status': 'started',
                'timestamp': datetime.now().isoformat()
            })
            
            try:
                # 🔥 关键：使用AI相似性分析器获取相关主题
                related_themes = await self.theme_fetcher.fetch_related_themes(event, limit=5)
                self.processing_stats['ai_similarity_calls'] += 1
                
                result['related_themes_count'] = len(related_themes)
                result['processing_steps'][-1]['status'] = 'completed'
                result['processing_steps'][-1]['themes_found'] = len(related_themes)
                result['processing_steps'][-1]['method'] = 'ai_similarity_analysis'
                result['processing_steps'][-1]['duration'] = (datetime.now() - step_start).total_seconds()
                
                logger.info(f"📊 AI相似性分析找到 {len(related_themes)} 个相关主题 ({result['processing_steps'][-1]['duration']:.2f}s)")
                
                # 记录相似度信息
                if related_themes:
                    best_match = related_themes[0]
                    result['best_match'] = {
                        'theme_name': best_match.get('name'),
                        'similarity_score': best_match.get('similarity_score', 0),
                        'similarity_reason': best_match.get('similarity_reason', '')[:100]
                    }
                    
                    if show_progress:
                        logger.info(f"   🎯 最佳匹配: {best_match.get('name')} (相似度: {best_match.get('similarity_score', 0):.2f})")
                    
            except Exception as e:
                result['processing_steps'][-1]['status'] = 'failed'
                result['processing_steps'][-1]['error'] = str(e)
                result['processing_steps'][-1]['duration'] = (datetime.now() - step_start).total_seconds()
                logger.error(f"❌ AI相似性分析失败: {e} ({result['processing_steps'][-1]['duration']:.2f}s)")
                related_themes = []  # 使用空列表继续
            
            # === 步骤3：调用AI客户端进行决策 ===
            step_start = datetime.now()
            result['processing_steps'].append({
                'step': 'ai_decision',
                'status': 'started',
                'timestamp': datetime.now().isoformat()
            })
            
            try:
                ai_decision = await self.ai_client.analyze_event_with_context(
                    event_data=event,
                    related_themes=related_themes
                )
                result['ai_decision'] = ai_decision
                result['processing_steps'][-1]['status'] = 'completed'
                result['processing_steps'][-1]['decision'] = ai_decision.get('decision')
                result['processing_steps'][-1]['confidence'] = ai_decision.get('confidence')
                result['processing_steps'][-1]['duration'] = (datetime.now() - step_start).total_seconds()
                
                decision_type = ai_decision.get('decision', 'UNKNOWN')
                confidence = ai_decision.get('confidence', 0)
                logger.info(f"🤖 AI决策: {decision_type}, 置信度: {confidence:.2f} ({result['processing_steps'][-1]['duration']:.2f}s)")
                
            except Exception as e:
                result['processing_steps'][-1]['status'] = 'failed'
                result['processing_steps'][-1]['error'] = str(e)
                result['processing_steps'][-1]['duration'] = (datetime.now() - step_start).total_seconds()
                logger.error(f"❌ AI决策失败: {e} ({result['processing_steps'][-1]['duration']:.2f}s)")
                raise
            
            # === 步骤4：执行业务逻辑（数据库操作）===
            step_start = datetime.now()
            result['processing_steps'].append({
                'step': 'execute_business_logic',
                'status': 'started',
                'timestamp': datetime.now().isoformat()
            })
            
            execution_result = await self._execute_business_logic_robust(event_id, ai_decision, event)
            result['execution_result'] = execution_result
            
            # 更新状态
            if execution_result['status'] == 'created':
                self.processing_stats['created'] += 1
                result['status'] = 'created'
                result['theme_id'] = execution_result.get('theme_id')
            elif execution_result['status'] == 'merged':
                self.processing_stats['merged'] += 1
                result['status'] = 'merged'
                result['theme_id'] = execution_result.get('theme_id')
            elif execution_result['status'] == 'ignored':
                self.processing_stats['ignored'] += 1
                result['status'] = 'ignored'
            elif execution_result['status'] == 'duplicate_resolved':
                self.processing_stats['merged'] += 1  # 计入合并
                result['status'] = 'merged'
                result['theme_id'] = execution_result.get('theme_id')
                result['duplicate_resolved'] = True
            else:
                result['status'] = execution_result['status']
            
            result['processing_steps'][-1]['status'] = 'completed'
            result['processing_steps'][-1]['result'] = execution_result
            result['processing_steps'][-1]['duration'] = (datetime.now() - step_start).total_seconds()
            
            # 计算总处理时间
            total_duration = (datetime.now() - start_time).total_seconds()
            self.processing_stats['processing_time_total'] += total_duration
            
            status_icon = "✅" if result['status'] != 'failed' else "❌"
            logger.info(f"{status_icon} 事件 {event_id} 处理完成，状态: {result['status']} (总耗时: {total_duration:.2f}s)")
            
            if show_progress:
                logger.info(f"{'='*60}")
            
            return result
            
        except Exception as e:
            total_duration = (datetime.now() - start_time).total_seconds()
            logger.error(f"❌ 事件 {event_id} 处理失败: {e} (耗时: {total_duration:.2f}s)", exc_info=True)
            self.processing_stats['failed'] += 1
            
            result['status'] = 'failed'
            result['error'] = str(e)
            result['error_type'] = type(e).__name__
            result['total_duration'] = total_duration
            
            # 记录失败的步骤
            if 'processing_steps' in result and result['processing_steps']:
                for step in result['processing_steps']:
                    if step.get('status') == 'started':
                        step['status'] = 'failed'
                        step['error'] = str(e)
            
            if show_progress:
                logger.info(f"{'='*60}")
            
            return result
    
    async def _execute_business_logic_robust(self, 
                                           event_id: str, 
                                           ai_decision: Dict[str, Any],
                                           event_data: Dict[str, Any]) -> Dict[str, Any]:
        """
        健壮版业务逻辑：处理重复主题等异常情况
        
        Args:
            event_id: 事件ID
            ai_decision: AI决策结果
            event_data: 事件数据
            
        Returns:
            执行结果
        """
        decision_type = ai_decision.get('decision')
        target_theme_name = ai_decision.get('target_theme_name', '')
        confidence = ai_decision.get('confidence', 0.0)
        
        logger.info(f"🔧 执行业务逻辑，事件: {event_id}, 决策: {decision_type}, 目标主题: {target_theme_name}")
        
        # 如果没有数据库客户端，返回模拟结果
        if not self.db_client:
            logger.warning("未配置数据库客户端，返回模拟结果")
            return {
                'status': 'simulated',
                'decision': decision_type,
                'target_theme_name': target_theme_name,
                'message': '模拟执行（未配置数据库客户端）'
            }
        
        try:
            if decision_type == 'CREATE_NEW':
                # 创建新主题并关联事件
                theme_data = {
                    'name': target_theme_name,
                    'keywords': self._extract_keywords_from_event(event_data),
                    'description': ai_decision.get('reason', ''),
                    'discovery_source': 'enhanced_engine_ai_robust',
                    'discovery_confidence': confidence
                }
                
                # 使用安全创建方法处理重复主题
                theme = await self._safe_create_theme(theme_data)
                
                if not theme:
                    # 如果创建失败，转为合并操作
                    logger.warning(f"主题创建失败，转为合并操作: {target_theme_name}")
                    # 尝试获取现有主题
                    existing_theme = await self.db_client.get_theme_by_name(target_theme_name)
                    if existing_theme:
                        theme = existing_theme
                        operation_type = 'merged_existing'
                    else:
                        # 如果还是找不到，返回错误
                        raise Exception(f"无法创建或找到主题: {target_theme_name}")
                else:
                    operation_type = 'created'
                
                # 创建事件-主题关联
                relation = await self.db_client.create_event_theme_relation(
                    event_id=event_id,
                    theme_id=theme['id'],
                    confidence=confidence,
                    evidence={
                        'ai_reason': ai_decision.get('reason'),
                        'comparison_analysis': ai_decision.get('comparison_analysis', ''),
                        'source': 'enhanced_engine_ai_robust',
                        'similarity_analysis': '使用AI相似性分析',
                        'original_decision': 'CREATE_NEW',
                        'actual_operation': operation_type
                    }
                )
                
                # 标记事件已处理
                await self.db_client.mark_event_processed(event_id)
                
                if operation_type == 'created':
                    logger.info(f"✅ 创建新主题: {target_theme_name} (ID: {theme['id']})")
                    return {
                        'status': 'created',
                        'theme_id': theme['id'],
                        'theme_name': theme['name'],
                        'relation_id': relation['id'],
                        'operation_type': operation_type,
                        'message': '成功创建新主题并关联事件'
                    }
                else:
                    logger.info(f"🔄 使用现有主题: {target_theme_name} (ID: {theme['id']})")
                    return {
                        'status': 'duplicate_resolved',
                        'theme_id': theme['id'],
                        'theme_name': theme['name'],
                        'relation_id': relation['id'],
                        'operation_type': operation_type,
                        'message': '重复主题已处理，使用现有主题'
                    }
            
            elif decision_type == 'MERGE_INTO':
                # 将事件合并到现有主题
                
                # 首先获取主题ID
                theme = await self.db_client.get_theme_by_name(target_theme_name)
                if not theme:
                    # 如果主题不存在，尝试创建它
                    logger.warning(f"目标主题 '{target_theme_name}' 不存在，尝试创建")
                    try:
                        theme_data = {
                            'name': target_theme_name,
                            'keywords': self._extract_keywords_from_event(event_data),
                            'discovery_source': 'enhanced_engine_ai_robust',
                            'discovery_confidence': confidence
                        }
                        theme = await self._safe_create_theme(theme_data)
                    except Exception as create_error:
                        logger.error(f"创建主题失败: {create_error}")
                        raise
                
                # 创建事件-主题关联
                relation = await self.db_client.create_event_theme_relation(
                    event_id=event_id,
                    theme_id=theme['id'],
                    confidence=confidence,
                    evidence={
                        'ai_reason': ai_decision.get('reason'),
                        'comparison_analysis': ai_decision.get('comparison_analysis', ''),
                        'merge_decision': True,
                        'source': 'enhanced_engine_ai_robust',
                        'similarity_analysis': '使用AI相似性分析'
                    }
                )
                
                # 标记事件已处理
                await self.db_client.mark_event_processed(event_id)
                
                logger.info(f"🔀 将事件合并到主题: {target_theme_name} (ID: {theme['id']})")
                
                return {
                    'status': 'merged',
                    'theme_id': theme['id'],
                    'theme_name': theme['name'],
                    'relation_id': relation['id'],
                    'message': '成功将事件合并到现有主题'
                }
            
            elif decision_type == 'IGNORE':
                # 忽略事件，只标记为已处理
                await self.db_client.mark_event_processed(event_id)
                
                logger.info(f"⏭️ 忽略事件: {event_id}")
                
                return {
                    'status': 'ignored',
                    'message': '事件被忽略',
                    'reason': ai_decision.get('reason', '')
                }
            
            else:
                logger.warning(f"❓ 未知决策类型: {decision_type}，标记为已处理")
                await self.db_client.mark_event_processed(event_id)
                
                return {
                    'status': 'unknown_decision',
                    'decision_type': decision_type,
                    'message': '未知决策类型，已标记为处理'
                }
                
        except Exception as e:
            logger.error(f"❌ 执行业务逻辑失败: {e}")
            raise
    
    def _extract_keywords_from_event(self, event_data: Dict[str, Any]) -> List[str]:
        """从事件中提取关键词（仅用于描述，不用于匹配）"""
        keywords = []
        
        # 从标题提取
        title = event_data.get('title', '')
        if title:
            chinese_words = re.findall(r'[\u4e00-\u9fff]{2,4}', title)
            keywords.extend(chinese_words[:3])
        
        # 添加行业
        industries = event_data.get('impact_industries', [])
        keywords.extend(industries)
        
        # 去重
        return list(set(keywords))[:5]
    
    async def batch_process_events(self, 
                                 events: List[Dict[str, Any]], 
                                 show_progress: bool = True,
                                 batch_size: int = 10) -> List[Dict[str, Any]]:
        """
        批量处理事件
        
        Args:
            events: 事件列表
            show_progress: 是否显示进度信息
            batch_size: 每批显示进度的数量
            
        Returns:
            处理结果列表
        """
        logger.info(f"🚀 开始批量处理 {len(events)} 个事件（使用AI相似性分析）")
        
        results = []
        for i, event in enumerate(events):
            try:
                if show_progress and (i % batch_size == 0 or i == len(events) - 1):
                    logger.info(f"\n📋 处理进度: {i+1}/{len(events)} ({(i+1)/len(events)*100:.1f}%)")
                
                result = await self.process_single_event(event, show_progress=False)
                results.append(result)
                
                # 每处理batch_size个事件输出一次简要统计
                if show_progress and (i + 1) % batch_size == 0:
                    success_count = sum(1 for r in results if r['status'] != 'failed')
                    logger.info(f"   ✅ 当前成功: {success_count}/{i+1}")
                
            except Exception as e:
                logger.error(f"❌ 处理事件失败: {event.get('id', 'unknown')}, 错误: {e}")
                results.append({
                    'event_id': event.get('id', 'unknown'),
                    'status': 'failed',
                    'error': str(e)
                })
        
        success_count = sum(1 for r in results if r['status'] != 'failed')
        logger.info(f"\n{'='*60}")
        logger.info(f"🎉 批量处理完成!")
        logger.info(f"   总计: {len(events)} 个事件")
        logger.info(f"   成功: {success_count} 个")
        logger.info(f"   失败: {len(events) - success_count} 个")
        logger.info(f"   成功率: {success_count/len(events)*100:.1f}%")
        logger.info(f"{'='*60}")
        
        return results
    
    def get_stats(self) -> Dict[str, Any]:
        """获取处理统计信息"""
        stats = dict(self.processing_stats)
        
        # 计算成功率
        if stats['total_processed'] > 0:
            success_count = stats['created'] + stats['merged'] + stats['ignored']
            stats['success_rate'] = success_count / stats['total_processed']
            stats['ai_similarity_call_rate'] = stats['ai_similarity_calls'] / stats['total_processed']
            
            # 平均处理时间
            if stats['processing_time_total'] > 0:
                stats['avg_processing_time'] = stats['processing_time_total'] / stats['total_processed']
            
            # 重复主题解决率
            if stats['duplicate_resolved'] > 0:
                stats['duplicate_resolution_rate'] = stats['duplicate_resolved'] / stats['total_processed']
        
        return stats
    
    def get_engine_info(self) -> Dict[str, Any]:
        """获取引擎信息"""
        return {
            'engine_version': 'ai_similarity_engine_robust_v1',
            'components_available': {
                'ai_client': self.ai_client is not None,
                'database_client': self.db_client is not None,
                'similarity_analyzer': self.similarity_analyzer is not None,
                'theme_fetcher': self.theme_fetcher is not None
            },
            'analysis_method': 'ai_similarity_analysis',
            'features': [
                '重复主题自动处理',
                '详细进度跟踪', 
                '健壮错误处理',
                '性能统计'
            ],
            'thresholds': {
                'fast_track_threshold': self.fast_track_threshold,
                'review_threshold': self.review_threshold,
                'ignore_threshold': self.ignore_threshold
            },
            'processing_stats': self.get_stats()
        }
    
    def print_detailed_summary(self) -> None:
        """打印详细摘要"""
        stats = self.get_stats()
        
        print("\n" + "="*70)
        print("📊 引擎处理详细摘要")
        print("="*70)
        
        print(f"📈 处理统计:")
        print(f"   总处理事件: {stats['total_processed']}")
        print(f"   创建主题: {stats['created']}")
        print(f"   合并到主题: {stats['merged']}")
        print(f"   忽略事件: {stats['ignored']}")
        print(f"   失败事件: {stats['failed']}")
        print(f"   重复主题解决: {stats.get('duplicate_resolved', 0)}")
        
        print(f"\n🎯 成功率: {stats.get('success_rate', 0)*100:.1f}%")
        
        if 'avg_processing_time' in stats:
            print(f"⏱️  平均处理时间: {stats['avg_processing_time']:.2f}秒/事件")
        
        if 'ai_similarity_calls' in stats:
            print(f"🤖 AI相似性分析调用: {stats['ai_similarity_calls']}次")
        
        print(f"\n⚙️  引擎配置:")
        print(f"   快速通道阈值: {self.fast_track_threshold}")
        print(f"   评审阈值: {self.review_threshold}")
        print(f"   忽略阈值: {self.ignore_threshold}")
        
        print(f"\n🔧 引擎特性:")
        for feature in self.get_engine_info()['features']:
            print(f"   ✅ {feature}")
        
        print("="*70)

# 测试函数
async def test_enhanced_engine_robust():
    """测试增强的健壮版引擎"""
    print("🧪 测试EnhancedThemeDiscoveryEngine（AI相似性分析健壮版）...")
    
    # 检查API密钥
    import os
    if not os.getenv('DEEPSEEK_API_KEY'):
        print("⚠️  DEEPSEEK_API_KEY未设置，跳过真实测试")
        return True
    
    try:
        # 导入组件
        from database_service.config import DatabaseConfig
        from database_service.memory_manager import MemoryDatabaseManager
        from database_service.client import DatabaseClient
        
        from model_service.llm_parser.reliable_deepseek_parser import ReliableDeepSeekParser
        from theme_service.ai_similarity_analyzer import AIThemeSimilarityAnalyzer
        from theme_service.enhanced_ai_client import EnhancedAIThemeClient
        
        # 初始化数据库
        db_config = DatabaseConfig()
        db_manager = MemoryDatabaseManager(db_config)
        await db_manager.connect()
        db_client = DatabaseClient(db_manager)
        
        # 添加测试主题（包含重复主题测试）
        print("📝 准备测试数据...")
        test_themes = [
            ("人工智能芯片", ["AI", "芯片", "半导体", "英伟达"], "AI专用芯片技术"),
            ("AR/VR设备", ["AR", "VR", "眼镜", "头显"], "增强现实和虚拟现实设备"),
            ("智能眼镜", ["AR", "眼镜", "智能穿戴"], "智能眼镜相关主题")  # 这个主题会用于重复测试
        ]
        
        for name, keywords, desc in test_themes:
            await db_manager.create_theme(
                name=name,
                keywords=keywords,
                description=desc
            )
        
        stats = await db_manager.get_stats()
        print(f"✅ 数据库初始化完成，主题数: {stats['total_themes']}")
        
        # 初始化AI组件
        print("🤖 初始化AI组件...")
        ai_parser = ReliableDeepSeekParser(config={'timeout': 60})
        similarity_analyzer = AIThemeSimilarityAnalyzer(ai_parser)
        ai_client = EnhancedAIThemeClient()
        
        # 创建引擎
        print("🚀 创建主题发现引擎...")
        engine = EnhancedThemeDiscoveryEngine(
            ai_client=ai_client,
            database_client=db_client,
            similarity_analyzer=similarity_analyzer,
            config={
                'fast_track_threshold': 0.8,
                'review_threshold': 0.6
            }
        )
        
        engine_info = engine.get_engine_info()
        print(f"✅ 引擎初始化完成: {engine_info['engine_version']}")
        print(f"   特性: {', '.join(engine_info['features'])}")
        
        # 测试事件（包含重复主题场景）
        print("\n📋 准备测试事件...")
        test_events = [
            {
                "id": "test_robust_001",
                "title": "英伟达发布新一代AI芯片H100",
                "summary": "英伟达发布性能更强的AI芯片H100，算力大幅提升",
                "event_type": "产品发布",
                "impact_industries": ["人工智能", "半导体", "芯片"],
                "theme_directive": {"action": "CREATE_NEW", "confidence": 0.85, "reason": "重大技术突破"}
            },
            {
                "id": "test_robust_002",
                "title": "新款智能眼镜发布测试",
                "summary": "某公司发布新款智能眼镜，支持AR功能",
                "event_type": "产品发布",
                "impact_industries": ["AR/VR", "消费电子"],
                "theme_directive": {"action": "CREATE_NEW", "confidence": 0.8, "reason": "新产品发布"}
            },
            {
                "id": "test_robust_003",
                "title": "AR头显市场增长迅速",
                "summary": "AR头显市场年增长率超过50%",
                "event_type": "市场分析",
                "impact_industries": ["AR/VR", "消费电子"],
                "theme_directive": {"action": "CREATE_NEW", "confidence": 0.75, "reason": "市场趋势"}
            }
        ]
        
        # 处理事件
        print(f"\n🚀 处理 {len(test_events)} 个测试事件...")
        results = await engine.batch_process_events(test_events, show_progress=True)
        
        # 显示详细结果
        print("\n📊 测试结果详情:")
        for i, result in enumerate(results):
            status_icon = "✅" if result['status'] != 'failed' else "❌"
            print(f"{i+1}. {status_icon} {result['event_id']}: {result['status']}")
            
            if 'ai_decision' in result:
                decision = result['ai_decision'].get('decision')
                confidence = result['ai_decision'].get('confidence', 0)
                print(f"   决策: {decision}, 置信度: {confidence:.2f}")
            
            if 'best_match' in result:
                best = result['best_match']
                print(f"   最佳匹配: {best['theme_name']} (相似度: {best['similarity_score']:.2f})")
            
            if result.get('duplicate_resolved'):
                print(f"   🔄 重复主题已自动处理")
        
        # 打印详细摘要
        engine.print_detailed_summary()
        
        # 清理资源
        print("\n🧹 清理资源...")
        await ai_parser.close()
        await db_manager.disconnect()
        
        print(f"\n✅ 健壮版引擎测试完成!")
        return True
        
    except Exception as e:
        print(f"❌ 测试失败: {e}")
        import traceback
        traceback.print_exc()
        return False

if __name__ == "__main__":
    # 确保路径正确
    import os
    import sys
    current_dir = os.path.dirname(os.path.abspath(__file__))
    project_root = os.path.dirname(current_dir)
    sys.path.insert(0, project_root)
    
    import asyncio
    asyncio.run(test_enhanced_engine_robust())