from theme_service.database import ThemeDatabase
from theme_service.config import settingsimport logging
from theme_service.models.mapping import save_event_theme
from theme_service.services.theme_mapper import map_event_to_themes
# from theme_service.database import get_conn

logger = logging.getLogger(__name__)

async def scheduler_loop():
    await run_once()
    
async def run_once():
    logger.info("theme_service scheduler running a cycle")

    conn = await get_conn()
    try:
        # 1. 读取待处理的事件（示例：只取最近10条）
        rows = await conn.fetch("""
            SELECT id, event_type, impact_industries, summary 
            FROM news_event 
            ORDER BY created_at DESC 
            LIMIT 10
        """)
        for row in rows:
            event = dict(row)
            event_id = event.pop('id')

            # 2. 调用规则映射
            matched_themes = await map_event_to_themes(event)

            # 3. 保存映射关系
            for theme in matched_themes:
                await save_event_theme(event_id, theme['theme_id'], theme['confidence'])

        logger.info(f"Processed {len(rows)} events")
    except Exception as e:
        logger.error(f"Error in run_once: {e}")
    finally:
        await conn.close()

