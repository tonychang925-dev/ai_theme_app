{"subject_id": "9022763", "chunk_id": "fb40d3143093", "area": "event_area", "context_heading": "农机行业动态", "date_hint": "2024年7月2日", "global_order": 4, "source": "detail_html", "created_at": "2026-04-01T01:36:17", "source_id": "detail_9022763_0", "order": 4, "used_fallback": false, "event_date_raw": "2024年7月2日", "text": "最高可领3万元，农机报废更新补贴政策来了"}
{"subject_id": "9022763", "chunk_id": "0896a7485fea", "area": "event_area", "context_heading": "农机行业动态", "date_hint": "2023年12月", "global_order": 6, "source": "detail_html", "created_at": "2026-04-01T01:36:17", "source_id": "detail_9022763_0", "order": 6, "used_fallback": false, "event_date_raw": "2023年12月", "text": "高标准农田建设项目已作为增发国债第一批项目正式下达。本次增发国债支持高标准农田建设项目规模共计5400万亩，安排增发国债资金1254亿元，共支持项目1336个。"}
