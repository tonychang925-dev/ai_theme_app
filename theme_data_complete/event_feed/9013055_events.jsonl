{"subject_id": "9013055", "chunk_id": "98ee53e2d5b0", "area": "event_area", "context_heading": "物流产业链动态", "date_hint": "2024年9月10日", "global_order": 9, "source": "detail_html", "created_at": "2026-04-01T08:06:00", "source_id": "detail_9013055_0", "order": 9, "used_fallback": false, "event_date_raw": "2024年9月10日", "text": "9月10日电，中国物流与采购联合会今天（10日）发布《中国供应链发展报告（2023-2024）》。"}
