{"ancestors": "0,9014198", "bizKey": "9017413", "createBy": null, "createTime": "2023-08-08 16:55:23", "detail": "<p style=\"text-align: start;\">汽车模具是汽车制造过程中用于成型各种塑料件、金属件或复合材料件的专用工具。以下是一些常见的汽车模具类型及其用途：</p><ol><li style=\"text-align: start;\">注塑模具（Injection Mold）：用途：用于生产塑料内饰件，如仪表板、门板、中控台等。</li><li style=\"text-align: start;\">冲压模具（Stamping Die）：用途：用于金属板材的成型，如车身覆盖件、车架部件等。</li></ol>", "firstLetter": "MJ", "imgUrl": null, "importance": 2, "level": 2, "limitUpTimes": 1, "name": "模具", "parentId": 9014198, "pctChg": 1.04, "reason": "汽车模具分为注塑模具和冲压模具", "remark": "", "sort": 10, "status": "1", "subjectId": 9017413, "type": 1, "updateBy": null, "updateTime": "2024-07-10 17:58:13"}
