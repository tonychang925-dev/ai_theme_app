{"ancestors": "0,9019807,9033770", "bizKey": "9033771", "createBy": null, "createTime": "2024-10-22 22:07:05", "detail": "<p style=\"text-align: center;\"><strong>火箭部件介绍</strong></p><p><img src=\"https://guduoduo-app.oss-cn-beijing.aliyuncs.com/upload/rich/2024/10/22/fc8dd7f1-e47b-43c9-8f6d-edf266a33e15-1729606305014.png\" alt=\"\" data-href=\"\" style=\"\"/></p><p><span style=\"color: rgb(13, 13, 13); font-family: 黑体;\">按能源动力分类，火箭可分为化学火箭、电火箭、核能火箭、太阳能火箭，其中化学火箭又可分为固体火箭、液体火箭和固液混合火箭三类。目前主流运载火箭较多使用化学火箭。按照近地轨道运载能力，火箭又可分为大、中、小及重型运载火箭。</span></p><p><img src=\"https://guduoduo-app.oss-cn-beijing.aliyuncs.com/upload/rich/2024/10/23/d3c55408-b46e-41a4-a0e5-d592cb4b801d-1729659703178.png\" alt=\"\" data-href=\"\" style=\"\"/></p>", "firstLetter": "HJBJ", "imgUrl": "", "importance": 2, "level": 3, "limitUpTimes": 0, "name": "火箭部件", "parentId": 9033770, "pctChg": -1.19, "reason": "火箭部件", "remark": "", "sort": 1, "status": "1", "subjectId": 9033771, "type": 1, "updateBy": null, "updateTime": "2026-01-22 15:51:37"}
