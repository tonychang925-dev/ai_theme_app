{"ancestors": "0,9019807", "bizKey": "9033770", "createBy": null, "createTime": "2024-10-22 22:06:20", "detail": "<p style=\"text-align: center;\">卫星发射介绍</p><p><span style=\"color: rgb(13, 13, 13); font-family: 黑体;\">典型运载火箭制造成本包括发动机、结构、电子设备。运载火箭的第一级成本构成中，发动机占比 </span><span style=\"color: rgb(13, 13, 13); font-family: Arial;\">54.3%</span><span style=\"color: rgb(13, 13, 13); font-family: 黑体;\">，箭体结构占比 </span><span style=\"color: rgb(13, 13, 13); font-family: Arial;\">23.5%</span><span style=\"color: rgb(13, 13, 13); font-family: 黑体;\">，电子设备占比为 </span><span style=\"color: rgb(13, 13, 13); font-family: Arial;\">8%</span><span style=\"color: rgb(13, 13, 13); font-family: 黑体;\">；第二级成本构成中，发动机、结构、电子设备占比相当，约为 </span><span style=\"color: rgb(13, 13, 13); font-family: Arial;\">28%</span><span style=\"color: rgb(13, 13, 13); font-family: 黑体;\">左右。其他设备包括阀门、电缆、操纵机构等占比相对较低。</span></p><p><img src=\"https://guduoduo-app.oss-cn-beijing.aliyuncs.com/upload/rich/2024/10/23/e835f37c-942e-4bad-b105-b6ce1566bb36-1729659873366.png\" alt=\"\" data-href=\"\" style=\"\"/></p>", "firstLetter": "WXFS", "imgUrl": "", "importance": 2, "level": 2, "limitUpTimes": 0, "name": "卫星发射", "parentId": 9019807, "pctChg": -1.03, "reason": "卫星发射", "remark": "", "sort": 7, "status": "1", "subjectId": 9033770, "type": 1, "updateBy": null, "updateTime": "2025-12-26 17:21:28"}
