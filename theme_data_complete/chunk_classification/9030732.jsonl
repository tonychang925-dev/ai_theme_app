{"chunk_id": "2b632d1ccbd0", "area": "event_area", "context_heading": "胖东来产业动态", "date_hint": "2024年11月26日", "text": "11月25日，#胖东来卫生巾区遭哄抢#冲上热搜。近日，据媒体报道，多家卫生巾品牌被曝“塌房”，胖东来卫生巾区域爆火。", "image_only": false, "classification": {"chunk_id": "2b632d1ccbd0", "label": "pure_event", "confidence": 0.5, "ontology_value": "low", "reason": "fallback: missing from LLM response", "is_fallback": true}, "final_bucket": "pure_event", "used_fallback": true}
