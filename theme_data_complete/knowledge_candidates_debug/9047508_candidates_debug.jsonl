{"subject_id": "9047508", "chunk_id": "53706d44104b", "area": "knowledge_area", "context_heading": "总体趋势", "date_hint": "", "global_order": 1, "source": "candidate_mixed", "created_at": "2026-04-01T12:11:24", "source_id": "detail_9047508_0", "order": 0, "used_fallback": true, "title": "总体趋势", "text": "2024年上半年，中国上市公司海外收入达3.83万亿元，同比增长12.84%，占总营收的10.98%。海外收入占比高的企业整体业绩更优，净利润增速显著高于依赖国内市场的企业。这一现象与全球产业链布局深化、技术竞争力提升及本土化战略密切相关。", "uid": "d6c50692da79", "decision": "drop", "confidence": 0.5, "knowledge_value": "low", "reason": "fallback: missing from judge response", "knowledge_spans": [], "event_residue": "", "drop_target": "noise"}
