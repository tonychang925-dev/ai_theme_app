{"subject_id": "9019060", "chunk_id": "b4544a1a1fd8", "area": "knowledge_area", "context_heading": "新型工业化介绍", "date_hint": "", "global_order": 7, "source": "candidate_mixed", "created_at": "2026-04-01T09:48:30", "source_id": "detail_9019060_0", "order": 1, "used_fallback": true, "title": "新型工业化介绍", "text": "推进新型工业化有两条主要路径：一是推进传统制造业自动化、数字化、智能化转型升级，提高制造业附加值。重点受益方向包括工业母机和刀具、工业软件和流程自动化、工控和工业机器人、传感器和检测、工业基础件。二是培育发展战略新兴产业，科技成长型赛道受益，主要方向包括人形机器人、激光及设备、半导体设备、3D打印、新能源装备等。", "uid": "6e7bf269cdbd", "decision": "drop", "confidence": 0.5, "knowledge_value": "low", "reason": "fallback: missing from judge response", "knowledge_spans": [], "event_residue": "", "drop_target": "noise"}
