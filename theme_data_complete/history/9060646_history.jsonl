{"ancestors": "0", "bizKey": null, "createBy": null, "createTime": "2026-01-29 13:17:46", "description": "【驱动事件：字节已于2025年底开启豆包手机助手正式版项目，新机预计将于2026年Q2中晚期发布】\n\n字节已于2025年底开启豆包手机助手正式版项目，新机预计将于2026年Q2中晚期发布。有供应链人士称，字节对新机的预期不低，比第一代的测试版大大提升。在模式方面，豆包二代手机依旧合作中兴努比亚，由中兴负责硬件，豆包负责AI。对此，字节方面暂无回复。（新闻来源：36氪）", "firstSubjectId": null, "firstSubjectName": null, "heat": "1", "heatName": "热", "hisPctChg": -2.27, "imgUrl": "", "pctChg": -0.62, "rankDate": "2026-01-29 00:00:00", "red": 0, "secondSubjectId": null, "secondSubjectName": null, "sort": 1, "subjectId": 9060646, "subjectName": "努比亚手机", "subjectRankId": 9381, "type": 3, "updateBy": null, "updateTime": "2026-01-29 13:17:46"}
