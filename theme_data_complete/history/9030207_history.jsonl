{"ancestors": "0", "bizKey": null, "createBy": null, "createTime": "2025-06-20 14:30:57", "description": "【驱动事件：以军称袭击伊朗多地导弹和雷达系统】\n\n据央视新闻，以色列空军当地时间6月20日袭击了伊朗伊斯法罕的几个地空导弹系统。以军称，连日来，以色列的战斗机对位于伊斯法罕和德黑兰地区的伊朗导弹和雷达系统发动了袭击，继控制德黑兰领空之后，此次袭击扩大了以色列空军在伊朗领空的行动自由。以色列空军将持续攻击伊朗西部和中部的军事目标。以军还表示，将继续致力于增强其在伊朗领空的行动力度，并取得空中优势。对此，伊朗方面暂无回应。（新闻来源：央视新闻）", "firstSubjectId": null, "firstSubjectName": null, "heat": "1", "heatName": "热", "hisPctChg": -1.59, "imgUrl": "", "pctChg": 0.5, "rankDate": "2025-06-20 00:00:00", "red": 0, "secondSubjectId": null, "secondSubjectName": null, "sort": 1, "subjectId": 9030207, "subjectName": "导弹", "subjectRankId": 5418, "type": 3, "updateBy": null, "updateTime": "2025-08-04 18:39:34"}
