{"ancestors": "0", "bizKey": null, "createBy": null, "createTime": "2025-04-09 09:03:37", "description": "【新题材更新：中欧贸易】\n\n国务院总理4月8日下午同欧盟委员会主席通电话，其中欧盟委员会主席提到欧方愿同中方推进各领域高层对话，深化经贸、绿色经济、气候变化等领域互利合作。美国加征关税严重冲击国际贸易，对欧中及弱势国家造成严重影响。欧中致力于维护以世贸组织为核心、公平自由的多边贸易体制，维护全球经济贸易关系健康稳定发展，这符合双方和世界共同利益。（新闻来源：中国政府网）", "firstSubjectId": null, "firstSubjectName": null, "heat": "1", "heatName": "热", "hisPctChg": 6.74, "imgUrl": "", "pctChg": -0.5, "rankDate": "2025-04-09 00:00:00", "red": 1, "secondSubjectId": null, "secondSubjectName": null, "sort": 1, "subjectId": 9046092, "subjectName": "中欧贸易", "subjectRankId": 4319, "type": 2, "updateBy": null, "updateTime": "2025-08-04 18:39:34"}
