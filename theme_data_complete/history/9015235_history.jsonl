{"ancestors": "0", "bizKey": null, "createBy": null, "createTime": "2026-02-04 09:57:46", "description": "【驱动事件：工信部部长李乐成主持召开会议强调氢能等领域攻关突破】\n\n2月3日，工信部部长李乐成主持召开会议。会议强调，加强未来产业科技供给。推动氢能、脑机接口、具身智能等领域攻关突破。（新闻来源：央视新闻）", "firstSubjectId": null, "firstSubjectName": null, "heat": "1", "heatName": "热", "hisPctChg": 3.44, "imgUrl": "", "pctChg": -1.5, "rankDate": "2026-02-04 00:00:00", "red": 0, "secondSubjectId": null, "secondSubjectName": null, "sort": 1, "subjectId": 9015235, "subjectName": "氢能源", "subjectRankId": 9473, "type": 3, "updateBy": null, "updateTime": "2026-02-04 09:57:46"}
