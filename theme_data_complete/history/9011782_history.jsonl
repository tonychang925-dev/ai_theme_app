{"ancestors": "0", "bizKey": null, "createBy": null, "createTime": "2025-06-17 14:54:14", "description": "【驱动事件：3艘船只在霍尔木兹海峡附近的阿曼湾海域起火】\n\n据央视新闻报道，3艘船只在霍尔木兹海峡附近的阿曼湾海域起火。伊朗法尔斯通讯社发布了据称是起火船只的照片。“也门新闻频道”网站引用了一张美国航空航天局（NASA）下属资源管理信息系统火灾信息（FIRMS）的实时卫星照片，显示相关海域疑似起火点。（新闻来源：央视新闻）", "firstSubjectId": null, "firstSubjectName": null, "heat": "1", "heatName": "热", "hisPctChg": 0.9, "imgUrl": "", "pctChg": -0.91, "rankDate": "2025-06-17 00:00:00", "red": 0, "secondSubjectId": null, "secondSubjectName": null, "sort": 1, "subjectId": 9011782, "subjectName": "一带一路", "subjectRankId": 5355, "type": 3, "updateBy": null, "updateTime": "2025-08-04 18:39:34"}
