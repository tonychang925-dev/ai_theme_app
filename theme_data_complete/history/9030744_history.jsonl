{"ancestors": "0", "bizKey": null, "createBy": null, "createTime": "2025-12-22 09:46:13", "description": "【驱动事件：普缆散纤已涨价约15%】\n\n近日市场热议光纤涨价。据看财经消息，有机构认为AI驱动光纤涨价。此前市场普遍认为，受限于运营商宽带投资放缓，光纤始终处于降价周期。但近日光纤开始涨价，国内头部四家光纤厂商，以及海外的康宁、藤仓等反馈，普缆散纤已涨价约15%。（新闻来源：新浪财经）", "firstSubjectId": null, "firstSubjectName": null, "heat": "1", "heatName": "热", "hisPctChg": 4.12, "imgUrl": "", "pctChg": -5, "rankDate": "2025-12-22 00:00:00", "red": 1, "secondSubjectId": null, "secondSubjectName": null, "sort": 1, "subjectId": 9030744, "subjectName": "光纤光缆", "subjectRankId": 8679, "type": 3, "updateBy": null, "updateTime": "2025-12-22 09:50:44"}
