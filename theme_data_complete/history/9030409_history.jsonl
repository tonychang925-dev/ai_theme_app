{"ancestors": "0", "bizKey": null, "createBy": null, "createTime": "2024-11-05 10:50:08", "description": "【驱动时间：苹果探索进军智能眼镜市场】\n\n消息称苹果探索进军智能眼镜市场，已启动代号Atlas项目。据知情人士称，苹果公司正在对目前市场上的产品进行内部研究，以探索进军智能眼镜领域，为该公司效仿Meta进入一个日益流行的产品类别做好准备。据不愿透露姓名的知情人士透露，这项代号为Atlas的计划于上周启动，涉及收集苹果员工对智能眼镜的反馈，并计划在不久的将来进行更多的焦点小组讨论。这些研究是由苹果硬件工程部门的产品系统质量团队领导的。", "firstSubjectId": null, "firstSubjectName": null, "heat": "1", "heatName": "热", "hisPctChg": 4.31, "imgUrl": null, "pctChg": -0.53, "rankDate": "2024-11-05 00:00:00", "red": 0, "secondSubjectId": null, "secondSubjectName": null, "sort": 1, "subjectId": 9030409, "subjectName": "AR眼镜", "subjectRankId": 2667, "type": 3, "updateBy": null, "updateTime": "2025-08-04 18:39:34"}
