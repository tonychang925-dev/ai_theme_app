{"ancestors": "0", "bizKey": null, "createBy": null, "createTime": "2024-09-20 09:34:26", "description": "【驱动事件：信创外网招标出现】\n\n9月18日，福建省发改委发布关于同意福建省监狱管理局信创改造项目可行性研究报告暨初步设计的函，项目建设规模及主要内容：对政务外网司法行政专用区中7536台终端进行国产化云桌面升级改造，并对151台便携式计算机进行国产化替代，同步配套国产操作系统和杀毒软件等配套软件。项目总投资概算4223.94万元，资金来源根据有关文件要求，由省发改委、省财政厅各承担50%，省发改委部分由数字福建专项资金支出。", "firstSubjectId": null, "firstSubjectName": null, "heat": "1", "heatName": "热", "hisPctChg": 2.14, "imgUrl": null, "pctChg": -0.47, "rankDate": "2024-09-20 00:00:00", "red": 1, "secondSubjectId": null, "secondSubjectName": null, "sort": 1, "subjectId": 9014648, "subjectName": "信创", "subjectRankId": 2336, "type": 3, "updateBy": null, "updateTime": "2025-08-04 18:39:34"}
