{"ancestors": "0", "bizKey": null, "createBy": null, "createTime": "2024-12-19 10:00:54", "description": "【驱动事件：深圳市工业和信息化局印发《深圳市打造人工智能先锋城市的若干措施》】\n\n深圳市工业和信息化局印发《深圳市打造人工智能先锋城市的若干措施》。措施提出，发放“训力券”。每年发放最高5亿元“训力券”，降低人工智能模型研发和训练成本。对租用智能算力开展大模型训练的企业、高等院校和科研机构，按不超过服务合同金额的50%，给予最高1000万元资助，对初创企业提高资助比例至60%。", "firstSubjectId": null, "firstSubjectName": null, "heat": "1", "heatName": "热", "hisPctChg": 4.0, "imgUrl": null, "pctChg": -1.07, "rankDate": "2024-12-19 00:00:00", "red": 1, "secondSubjectId": null, "secondSubjectName": null, "sort": 1, "subjectId": 9014001, "subjectName": "人工智能硬件", "subjectRankId": 3117, "type": 3, "updateBy": null, "updateTime": "2025-08-04 18:39:34"}
