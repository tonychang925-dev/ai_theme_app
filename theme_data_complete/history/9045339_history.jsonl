{"ancestors": "0", "bizKey": null, "createBy": null, "createTime": "2025-12-24 13:36:53", "description": "【驱动事件：中国科学院脑科学与智能技术卓越创新中心发布该中心与国内科研机构及医疗单位合作开展的第二例侵入式脑机接口临床试验取得的新进展】\n\n中国科学院脑科学与智能技术卓越创新中心发布该中心与国内科研机构及医疗单位合作开展的第二例侵入式脑机接口临床试验取得的新进展。本次临床试验在技术上实现了从二维的屏幕光标控制，到三维的物理世界交互的重大转变。(新闻来源：央视新闻)", "firstSubjectId": null, "firstSubjectName": null, "heat": "1", "heatName": "热", "hisPctChg": 1.93, "imgUrl": "", "pctChg": 0.15, "rankDate": "2025-12-24 00:00:00", "red": 0, "secondSubjectId": null, "secondSubjectName": null, "sort": 1, "subjectId": 9045339, "subjectName": "脑机接口", "subjectRankId": 8744, "type": 3, "updateBy": null, "updateTime": "2025-12-24 13:36:53"}
