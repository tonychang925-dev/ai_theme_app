                    ne.causal_claim,
                    ne.evidence_set,
                    ne.raw_event_json,
                    nr.title,
                    nr.content
                FROM news_event ne
                LEFT JOIN news_raw nr
                  ON nr.id = ne.news_id
                WHERE 1=1
            """
            params: List[Any] = []
            idx = 1

            if event_id is not None:
                sql += f" AND ne.id = ${idx}"
