          source_name = COALESCE(EXCLUDED.source_name, stock_daily_strategy_snapshot.source_name),
          updated_at = NOW()
        """
        payload = [
            (
                row.get("trade_date"),
                row.get("stock_id"),
                row.get("stock_name"),
                row.get("close_price"),
                row.get("pct_chg"),
                row.get("volume"),
                row.get("amount"),
                row.get("limit_up_price"),
                row.get("limit_down_price"),
