    async def create_theme_with_stream(self, name: str, code: str, **kwargs) -> Optional[Any]:
        """
        增强版创建主题：同时发布到 Stream（带重试）
        
        Args:
            name: 主题名称
            code: 主题代码
            **kwargs: 其他主题属性
            
        Returns:
            创建的主题记录
        """
        try:
            # 调用原有方法创建主题
            theme = await self._execute_with_retry_async(
                self.base_gateway.create_theme,
                operation_type="database_operation",
                context={"operation": "create_theme", "name": name, "code": code},
                name=name,
                code=code,
                **kwargs
            )
            
            if theme:
                # 发布主题创建事件到 Stream
                theme_data = {
                    "theme_id": theme.id,
                    "name": theme.name,
                    "code": theme.code,
                    "action": "create",
                    "created_at": datetime.now().isoformat()
                }
                
                await self.publish_theme_update(theme_data)
                
                logger.info(f"🎉 主题创建事件已发布到 Stream: {name} ({code})")
            
            return theme
            
        except Exception as e:
            logger.error(f"增强版创建主题失败: {e}")
            # 降级：尝试仅使用原有方法
            return await self.base_gateway.create_theme(name, code, **kwargs)
    
