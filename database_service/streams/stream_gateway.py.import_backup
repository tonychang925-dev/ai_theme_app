            }
            
            await self.publish_theme_update(heat_data)
            
            logger.debug(f"🔥 主题热度变化事件已发布到 Stream: {theme_id} +{increment}")
            
        except Exception as e:
            logger.error(f"增强版增加主题热度失败: {e}")
            # 降级：尝试仅使用原有方法
            await self.base_gateway.increment_theme_heat(theme_id, increment)
    
    # ========== 统计和监控增强 ==========
    
    async def get_enhanced_stats(self) -> Dict[str, Any]:
        """获取增强的统计信息（包含原有统计、Stream统计和重试统计）"""
        try:
            # 获取原有统计
            base_stats = await self.base_gateway.get_stats()
            
            # 获取 Stream 统计
            stream_stats = await self.get_stream_stats()
            
            # 合并统计
            enhanced_stats = {
                **base_stats,
                "stream_enhanced": True,
                "retry_enabled": self.enable_retry,
                "stream_stats": stream_stats,
                "retry_stats": self._get_retry_stats_summary(),
                "config": {
                    "enable_stream_processing": self.config.enable_stream_processing,
                    "redis_stream_enabled": self.config.redis_stream.enabled,
                    "stream_count": len(self.config.redis_stream.streams),
                    "consumer_group_count": len(self.config.redis_stream.consumer_groups)
                }
            }
            
            return enhanced_stats
            
        except Exception as e:
            logger.error(f"获取增强统计失败: {e}")
            # 降级：仅返回原有统计
            return await self.base_gateway.get_stats()
    
    async def health_check_with_streams(self) -> Dict[str, Any]:
        """增强版健康检查（包含Stream和重试健康状态）"""
        try:
            # 原有健康检查
            base_healthy = await self.base_gateway.health_check()
            
            # Stream 健康检查
            stream_healthy = False
            stream_error = None
            
            if self.stream_initialized:
                try:
                    # 尝试执行一个简单的 Stream 操作
                    test_stream = "news_raw"
                    stream_name = self.config.get_stream_url(test_stream)
                    
                    # 使用重试检查 Stream
                    info = await self._execute_with_retry_async(
                        self.stream_manager.get_stream_info,
                        operation_type="health_check",
                        context={"operation": "health_check_stream"},
                        stream_name=stream_name
                    )
                    
                    stream_healthy = "error" not in info
                    
                except Exception as e:
                    stream_error = str(e)
                    stream_healthy = False
            else:
                stream_healthy = True  # 未初始化不算错误
                stream_error = "Stream 未初始化"
            
            # 重试系统健康检查
            retry_healthy = True
            retry_error = None
            if self.enable_retry and not RETRY_MANAGER_AVAILABLE:
                retry_healthy = False
                retry_error = "重试管理器不可用"
            
            return {
                "overall": base_healthy and stream_healthy and retry_healthy,
                "database": {
                    "healthy": base_healthy,
                    "message": "数据库连接正常" if base_healthy else "数据库连接异常"
                },
                "stream": {
                    "healthy": stream_healthy,
                    "initialized": self.stream_initialized,
                    "enabled": self.config.redis_stream.enabled,
                    "error": stream_error,
                    "message": "Stream 系统正常" if stream_healthy else f"Stream 系统异常: {stream_error}"
                },
                "retry": {
                    "healthy": retry_healthy,
                    "enabled": self.enable_retry,
                    "available": RETRY_MANAGER_AVAILABLE,
                    "error": retry_error,
                    "message": "重试系统正常" if retry_healthy else f"重试系统异常: {retry_error}"
                },
                "timestamp": datetime.now().isoformat()
            }
            
        except Exception as e:
            logger.error(f"增强版健康检查失败: {e}")
            return {
                "overall": False,
                "database": {"healthy": False, "message": str(e)},
                "stream": {"healthy": False, "message": "检查失败"},
                "retry": {"healthy": False, "message": "检查失败"},
                "timestamp": datetime.now().isoformat()
            }
    
    # ========== 配置管理 ==========
    
    def enable_retry_function(self, enable: bool = True):
        """启用或禁用重试功能"""
        old_status = self.enable_retry
        self.enable_retry = enable and RETRY_MANAGER_AVAILABLE
        
        if old_status != self.enable_retry:
            if self.enable_retry:
                logger.info("✅ 重试功能已启用")
            else:
                logger.info("⏸️  重试功能已禁用")
    
    def update_retry_config(self, config_updates, 
                           operation_type: str = None):
        """
        更新重试配置
        
        Args:
            config_updates: 配置更新
            operation_type: 操作类型（None 表示全局配置）
        """
        if operation_type:
            # 更新特定操作配置
            if operation_type in self._operation_retry_configs:
                self._operation_retry_configs[operation_type].update(config_updates)
                logger.info(f"✅ 更新 {operation_type} 重试配置")
            else:
                self._operation_retry_configs[operation_type] = config_updates
                logger.info(f"✅ 添加 {operation_type} 重试配置")
        else:
            # 更新全局配置
            self.retry_config.update(config_updates)
            self._retry_manager = None  # 重置重试管理器
            logger.info("✅ 更新全局重试配置")
    
    def get_retry_config(self, operation_type: str = None) -> Dict[str, Any]:
        """获取重试配置"""
        if operation_type and operation_type in self._operation_retry_configs:
            return self._operation_retry_configs[operation_type].copy()
        else:
            return self.retry_config.copy()
    
    # ========== 工具方法 ==========
    
    def _detect_data_type(self, data) -> str:
        """自动检测数据类型"""
        if "title" in data and "content" in data:
            return "news"
        elif "classification" in data or "event_type" in data:
            return "event"
        elif "theme_id" in data or "theme_name" in data:
            return "theme"
        elif "updates" in data or "action" in data:
            return "theme"
        else:
            return "generic"
    
    def _determine_stream_key(self, data_type: str, data) -> str:
        """确定 Stream 键名"""
        stream_map = {
            "news": "news_raw",
            "event": "events_normal",
            "theme": "themes_updates",
            "generic": "generic_messages"
        }
        
        if data_type == "event" and data.get("severity") == "major":
            return "events_major"
        
        return stream_map.get(data_type, "generic_messages")
    
    def _get_retry_stats_summary(self) -> Dict[str, Any]:
        """获取重试统计摘要"""
        total_retry_operations = self.retry_stats['operations_with_retries']
        successful_retries = self.retry_stats['successful_retries']
        
        retry_success_rate = 0
        if total_retry_operations > 0:
            retry_success_rate = successful_retries / total_retry_operations
        
        return {
            "total_operations": self.retry_stats['total_operations'],
            "operations_with_retries": self.retry_stats['operations_with_retries'],
            "successful_retries": self.retry_stats['successful_retries'],
            "failed_retries": self.retry_stats['failed_retries'],
            "retry_success_rate": retry_success_rate,
            "retry_manager_available": RETRY_MANAGER_AVAILABLE,
            "retry_enabled": self.enable_retry
        }
    
    def print_retry_report(self):
        """打印重试报告"""
        if not self.enable_retry:
            print("重试功能已禁用")
            return
            
        stats = self._get_retry_stats_summary()
        
        print("\n📊 重试功能报告")
        print("=" * 50)
        print(f"总操作数: {stats['total_operations']}")
        print(f"带重试操作: {stats['operations_with_retries']}")
        print(f"成功重试: {stats['successful_retries']}")
        print(f"失败重试: {stats['failed_retries']}")
        
        if stats['operations_with_retries'] > 0:
            print(f"重试成功率: {stats['retry_success_rate']:.1%}")
        
        print(f"重试管理器: {'可用' if stats['retry_manager_available'] else '不可用'}")
        print("=" * 50)
    
    # ========== 原有方法（保持不变）==========
    
    async def _ensure_streams_exist(self):
        """确保所有配置的 Stream 都存在"""
        for stream_key, stream_def in self.config.redis_stream.streams.items():
            try:
                await self.stream_manager.ensure_stream(
                    stream_def.name, 
                    stream_def.max_length
                )
                logger.debug(f"✅ 确保 Stream 存在: {stream_def.name}")
            except Exception as e:
                logger.warning(f"⚠️  确保 Stream 存在失败 {stream_def.name}: {e}")
    
    async def _monitor_streams_task(self):
        """监控 Stream 状态的后台任务"""
        interval = self.config.redis_stream.metrics_interval
        
        while True:
            try:
                if self.stream_initialized:
                    await self._report_stream_metrics()
                await asyncio.sleep(interval)
            except asyncio.CancelledError:
                break
            except Exception as e:
                logger.error(f"Stream 监控任务错误: {e}")
                await asyncio.sleep(60)
    
    async def _report_stream_metrics(self):
        """报告 Stream 指标"""
        try:
            # 获取所有 Stream 的信息
            streams_info = await self.stream_manager.get_all_streams_info()
            
            # 统计消息总数
            total_messages = sum(info.get('length', 0) for info in streams_info.values())
            
            logger.debug(f"📊 Stream 监控 - 总消息数: {total_messages}")
            
            # 记录到统计中
            self.stream_stats['total_messages'] = total_messages
            self.stream_stats['streams_info'] = streams_info
            
        except Exception as e:
            logger.error(f"获取 Stream 指标失败: {e}")
    
    async def _dual_write_news(self, news_data):
        """双写模式：同时写入旧版事件总线"""
        if not self.legacy_event_bus_enabled:
            return
        
        try:
            logger.debug(f"双写模式：同时写入旧版新闻总线: {news_data.get('id')}")
        except Exception as e:
            logger.warning(f"双写模式写入旧版系统失败: {e}")
    
    async def _dual_write_event(self, event_data, is_major: bool):
        """双写模式：同时写入旧版事件总线"""
        if not self.legacy_event_bus_enabled:
            return
        
        try:
            logger.debug(f"双写模式：同时写入旧版事件总线: {event_data.get('id')}")
        except Exception as e:
            logger.warning(f"双写模式写入旧版系统失败: {e}")
    
    def _validate_news_data(self, news_data) -> bool:
        """验证新闻数据格式"""
        required_fields = ["id", "title", "content"]
        for field in required_fields:
            if field not in news_data:
                return False
        
        if len(news_data.get("content", "")) < 10:
            return False
        
        return True
    
    async def get_stream_info(self, stream_key: str = None) -> Dict[str, Any]:
        """获取 Stream 信息"""
        try:
            if not self.stream_initialized:
                return {"error": "Stream 未初始化"}
            
            if stream_key:
                stream_name = self.config.get_stream_url(stream_key)
                info = await self.stream_manager.get_stream_info(stream_name)
                return {stream_name: info}
            else:
                return await self.stream_manager.get_all_streams_info()
                
        except Exception as e:
            logger.error(f"获取 Stream 信息失败: {e}")
            return {"error": str(e)}
    
    async def get_stream_stats(self) -> Dict[str, Any]:
        """获取 Stream 统计信息"""
        try:
            stream_info = await self.get_stream_info()
            
            stats = {
                "initialized": self.stream_initialized,
                "enabled": self.config.redis_stream.enabled,
                "dual_write_enabled": self.dual_write_enabled,
                "legacy_event_bus_enabled": self.legacy_event_bus_enabled,
                "published_messages": self.stream_stats['published_messages'],
                "published_errors": self.stream_stats['published_errors'],
                "last_publish_time": self.stream_stats['last_publish_time'].isoformat() 
                    if self.stream_stats['last_publish_time'] else None,
                "streams": {}
            }
            
            for stream_key, stream_def in self.config.redis_stream.streams.items():
                stream_name = stream_def.name
                if stream_info and stream_name in stream_info:
                    stream_data = stream_info[stream_name]
                    stats["streams"][stream_name] = {
                        "length": stream_data.get("length", 0),
                        "groups": stream_data.get("groups", 0),
                        "published_count": self.stream_stats['streams'].get(stream_name, {}).get('published_count', 0)
                    }
            
            return stats
            
        except Exception as e:
            logger.error(f"获取 Stream 统计失败: {e}")
            return {"error": str(e)}
    
    def __getattr__(self, name):
        """代理所有未定义的方法到原有网关"""
        if hasattr(self.base_gateway, name):
            return getattr(self.base_gateway, name)
        raise AttributeError(f"'{self.__class__.__name__}' object has no attribute '{name}'")
    
    async def close(self):
        """关闭连接"""
        try:
            if self.stream_manager:
                await self.stream_manager.redis.close()
            
            await self.base_gateway.close()
            
            logger.info("✅ StreamEnhancedGateway 已关闭")
        except Exception as e:
            logger.error(f"关闭增强网关失败: {e}")