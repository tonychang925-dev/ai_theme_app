{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-theme-app.local/schemas/acceptance_traceability.schema.json",
  "title": "Acceptance Traceability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "generated_at",
    "source_files",
    "summary",
    "traceability",
    "gaps",
    "gate_ready"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_acceptance_targets",
        "mapped_acceptance_targets",
        "unmapped_acceptance_targets",
        "risk_level"
      ],
      "properties": {
        "total_acceptance_targets": { "type": "integer", "minimum": 0 },
        "mapped_acceptance_targets": { "type": "integer", "minimum": 0 },
        "unmapped_acceptance_targets": { "type": "integer", "minimum": 0 },
        "risk_level": { "type": "string", "enum": ["P0", "P1", "P2"] }
      }
    },
    "traceability": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acceptance_id", "case_ids", "commands", "expected"],
        "properties": {
          "acceptance_id": {
            "type": "string",
            "pattern": "^ACPT-[A-Za-z0-9.-]+-\\d{3}$"
          },
          "case_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^ACC-[A-Za-z0-9.-]+-\\d{2,3}$"
            }
          },
          "commands": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected": {
            "type": "string",
            "enum": ["pass", "fail", "blocked"]
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "gate_ready": {
      "type": "boolean"
    }
  }
}
