{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-theme-app.local/schemas/prd_traceability.schema.json",
  "title": "PRD Traceability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "generated_at",
    "source_files",
    "summary",
    "traceability",
    "gaps",
    "gate_ready"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "phase": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_requirements", "mapped_requirements", "unmapped_requirements", "risk_level"],
      "properties": {
        "total_requirements": { "type": "integer", "minimum": 0 },
        "mapped_requirements": { "type": "integer", "minimum": 0 },
        "unmapped_requirements": { "type": "integer", "minimum": 0 },
        "risk_level": { "type": "string", "enum": ["P0", "P1", "P2"] }
      }
    },
    "traceability": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "use_case_ids", "acceptance_ids", "test_case_ids", "wbs_task_ids"],
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^PRD-REQ-[A-Za-z0-9.-]+-\\d{3}$"
          },
          "use_case_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^PRD-UC-[A-Za-z0-9.-]+-\\d{2,3}$" }
          },
          "acceptance_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^ACPT-[A-Za-z0-9.-]+-\\d{3}$" }
          },
          "test_case_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "wbs_task_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "gate_ready": { "type": "boolean" }
  }
}
