# AI Theme App - Environment Variables Example
# Copy this file to .env and fill in your actual values

# Database Configuration
POSTGRES_PASSWORD=changeme123
DATABASE_URL=postgresql://ai_theme_user:${POSTGRES_PASSWORD}@postgres:5432/ai_theme_app

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# AI Service Configuration
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL_NAME=gpt-4
AI_MAX_TOKENS=2000

# Application Configuration
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=your_secret_key_here_change_this_in_production

# Monitoring Configuration
SENTRY_DSN=your_sentry_dsn_here
LOG_LEVEL=INFO

# Email Configuration (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Slack Configuration (for alerts)
SLACK_WEBHOOK_URL=your_slack_webhook_url

# Elasticsearch Configuration (for logs)
ELASTIC_PASSWORD=your_elastic_password

# Grafana Configuration
GRAFANA_ADMIN_PASSWORD=admin123

# Service URLs (for inter-service communication)
BACKEND_API_URL=http://backend:8000
FRONTEND_BFF_URL=http://frontend-bff:8001
MODEL_SERVICE_URL=http://model-service:8002

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Cache Configuration
CACHE_TTL=300
CACHE_MAX_SIZE=1000

# Security Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_NOTIFICATIONS=true
ENABLE_MONITORING=true

# Data Source Configuration (Legacy - for stock data)
REQUEST_INTERVAL_SECONDS=15
MAX_RETRY_TIMES=3
ENABLE_PROXY=false
ENABLED_SOURCES=akshare_cls,sina_rss
# Realtime Business Orchestrator — auto-start auction/market collectors during trading windows
REALTIME_ORCHESTRATOR_ENABLED=true
REALTIME_ORCHESTRATOR_ACTIONS_ENABLED=true
